local function replacePlain(text, findText, replacement)
	local startAt = 1
	while true do
		local first, last = string.find(text, findText, startAt, true)
		if not first then break end
		text = string.sub(text, 1, first - 1) .. replacement .. string.sub(text, last + 1)
		startAt = first + #replacement
	end
	return text
end

local function translateVisibleText(root, targetLanguage)
	for _, instance in ipairs(root:GetDescendants()) do
		for _, property in ipairs({ "Text", "PlaceholderText" }) do
			local ok, current = pcall(function() return instance[property] end)
			if ok and type(current) == "string" and current ~= "" then
				local translated = current
				for _, pair in ipairs(languagePairs) do
					local source, destination = pair[1], pair[2]
					if targetLanguage == "th" then source, destination = destination, source end
					translated = replacePlain(translated, source, destination)
				end
				if translated ~= current then pcall(function() instance[property] = translated end) end
			end
		end
	end
end
