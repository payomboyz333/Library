local compiler = loadstring
if type(compiler) ~= "function" then
	error("PAYOMBØYZ Example needs a runtime that provides loadstring. Enable it, then run Example.lua again.", 0)
end

local httpService = game:GetService("HttpService")
local moduleSource
local moduleSourceOrigin
local loadErrors = {}
local localModulePaths = {
	"PayomboyZ-UI/Obsidain_Glassmophic2.txt",
	"Obsidain_Glassmophic2.txt",
	"Library/PayomboyZ-UI/Obsidain_Glassmophic2.txt",
}
local localReader = type(readfile) == "function" and readfile or nil
if localReader then
	for _, path in ipairs(localModulePaths) do
		local ok, result = pcall(localReader, path)
		if ok and type(result) == "string" and #result > 100000 then
			moduleSource = result
			moduleSourceOrigin = "local file " .. path
			break
		end
		if not ok then loadErrors[#loadErrors + 1] = path .. ": " .. tostring(result) end
	end
end
if not moduleSource then
	for _, url in ipairs(moduleUrls) do
		local ok, result = pcall(function() return game:HttpGet(url, true) end)
		if not ok then ok, result = pcall(function() return httpService:GetAsync(url) end) end
		if ok and type(result) == "string" and #result > 100000 then
			moduleSource = result
			moduleSourceOrigin = url
			break
		end
		loadErrors[#loadErrors + 1] = url .. ": " .. tostring(result)
	end
end
if not moduleSource then
	error("PAYOMBØYZ UI could not be downloaded. Check HTTP access and that Library/PayomboyZ-UI is public. " .. table.concat(loadErrors, " | "), 0)
end
if not moduleSource:find("local outerContour = {", 1, true)
	or not moduleSource:find("function WindowObj:SetAccent(color)", 1, true)
	or not moduleSource:find("local function refreshSectionSize()", 1, true)
	or not moduleSource:find('ObsidianGlassEngine.Version = "4.9.2"', 1, true) then
	error("Example.lua found an older PAYOMBØYZ UI module at " .. tostring(moduleSourceOrigin)
		.. ". Put the current 4.9.2 Obsidain_Glassmophic2.txt in the executor workspace or publish the matching module, then run Example.lua again.", 0)
end

local compileOk, moduleChunk, compileError = pcall(compiler, moduleSource)
if not compileOk then compileError, moduleChunk = moduleChunk, nil end
if type(moduleChunk) ~= "function" then
	error("PAYOMBØYZ UI source could not be compiled: " .. tostring(compileError), 0)
end
local moduleOk, Library = pcall(moduleChunk)
if not moduleOk then error("PAYOMBØYZ UI failed to initialize: " .. tostring(Library), 0) end
if type(Library) ~= "table" or type(Library.CreateWindow) ~= "function" then
	error("Downloaded file did not return the full PAYOMBØYZ UI library.", 0)
end

