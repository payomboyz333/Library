        function TabObj:AddKeybind(idx, kCfg)
            kCfg = type(kCfg) == "table" and kCfg or {}
            local title = kCfg.Title or "Keybind"
            local mode = kCfg.Mode == "Hold" and "Hold" or "Toggle"
            local callback = kCfg.Callback or function() end
            local keyValue = kCfg.Default
            if type(keyValue) == "string" and Enum.KeyCode[keyValue] then keyValue = Enum.KeyCode[keyValue] end
            if typeof(keyValue) ~= "EnumItem" then keyValue = Enum.KeyCode.Unknown end

            local frame = Instance.new("Frame")
            frame.Name = "Keybind_" .. tostring(idx):gsub("[^%w_]", "_")
            frame.Size = UDim2.new(1, -10, 0, 44)
            frame.BackgroundColor3 = COLORS.glassDeep
            frame.BackgroundTransparency = 0.18
            frame.BorderSizePixel = 0
            frame.Parent = getControlContainer()
            local corner = Instance.new("UICorner", frame)
            corner.CornerRadius = UDim.new(0, 8)
            local stroke = Instance.new("UIStroke", frame)
            stroke.Color = COLORS.glassRaised
            stroke.Thickness = 1
            addAnimeEdge(frame)

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -118, 1, 0)
            label.Position = UDim2.fromOffset(12, 0)
            label.BackgroundTransparency = 1
            label.Text = title
            label.TextColor3 = COLORS.text
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 12
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame

            local keyButton = Instance.new("TextButton")
            keyButton.Size = UDim2.fromOffset(92, 28)
            keyButton.Position = UDim2.new(1, -104, 0.5, -14)
            keyButton.BackgroundColor3 = COLORS.surfaceRaised
            keyButton.BorderSizePixel = 0
            keyButton.TextColor3 = COLORS.text
            keyButton.Font = Enum.Font.GothamBold
            keyButton.TextSize = 10
            keyButton.AutoButtonColor = false
            keyButton.Parent = frame
            local keyCorner = Instance.new("UICorner", keyButton)
            keyCorner.CornerRadius = UDim.new(0, 6)

            local active = kCfg.Active == true
            local capture = false
            local function renderKey()
                keyButton.Text = capture and "PRESS KEY..." or (keyValue == Enum.KeyCode.Unknown and "UNBOUND" or keyValue.Name)
                keyButton.BackgroundColor3 = capture and COLORS.primaryPressed or (active and COLORS.primary or COLORS.surfaceRaised)
            end
            local keyObj = { Value = keyValue, Active = active, Mode = mode, Instance = frame, Button = keyButton }
            local function fire(nextActive)
                active = nextActive == true
                keyObj.Active = active
                renderKey()
                pcall(callback, keyValue, active)
            end
            function keyObj:SetActive(nextActive) fire(nextActive) end
            function keyObj:SetValue(value)
                if type(value) == "string" and Enum.KeyCode[value] then value = Enum.KeyCode[value] end
                if typeof(value) ~= "EnumItem" then return false end
                keyValue = value
                keyObj.Value = value
                renderKey()
                return true
            end
            function keyObj:SetMode(nextMode)
                if nextMode ~= "Toggle" and nextMode ~= "Hold" then return false end
                mode = nextMode
                keyObj.Mode = nextMode
                active = false
                keyObj.Active = false
                renderKey()
                return true
            end
            function keyObj:Capture()
                capture = true
                renderKey()
            end
            function keyObj:Get() return keyValue end
            function keyObj:GetValue() return keyValue end
            keyButton.Activated:Connect(function() keyObj:Capture() end)
            local beganConnection = UserInputService.InputBegan:Connect(function(input, processed)
                if capture then
                    capture = false
                    if input.KeyCode == Enum.KeyCode.Escape then keyObj:SetValue(Enum.KeyCode.Unknown)
                    elseif input.KeyCode ~= Enum.KeyCode.Unknown then keyObj:SetValue(input.KeyCode) end
                    renderKey()
                    return
                end
                if processed then return end
                if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode == keyValue then
                    if mode == "Toggle" then fire(not active) else fire(true) end
                end
            end)
            local endedConnection = UserInputService.InputEnded:Connect(function(input)
                if mode == "Hold" and active and input.KeyCode == keyValue then fire(false) end
            end)
            table.insert(trackedConnections, beganConnection)
            table.insert(trackedConnections, endedConnection)
            function keyObj:Destroy()
                if active then fire(false) end
                if beganConnection then beganConnection:Disconnect(); beganConnection = nil end
                if endedConnection then endedConnection:Disconnect(); endedConnection = nil end
                if frame.Parent then frame:Destroy() end
            end
            renderKey()
            ObsidianGlassEngine.Options[idx] = keyObj
            return keyObj
        end

