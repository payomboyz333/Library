        function TabObj:AddBarChart(idx, cCfg)
            cCfg = type(cCfg) == "table" and cCfg or {}
            local title = cCfg.Title or "Activity"
            local maximumPoints = math.clamp(math.floor(tonumber(cCfg.MaxPoints) or 16), 3, 32)
            local accent = typeof(cCfg.Color) == "Color3" and cCfg.Color or COLORS.primary
            local frame = Instance.new("Frame")
            frame.Name = "BarChart_" .. tostring(idx):gsub("[^%w_]", "_")
            frame.Size = UDim2.new(1, -10, 0, 154)
