                    tipLabel.TextSize = 10
                    tipLabel.TextWrapped = true
                    tipLabel.TextXAlignment = Enum.TextXAlignment.Left
                    tipLabel.ZIndex = 121
                    tipLabel.Parent = tooltip
                    local tipPadding = Instance.new("UIPadding", tooltip)
                    tipPadding.PaddingBottom = UDim.new(0, 7)
                    local function showTooltip()
                        local cameraNow = workspace.CurrentCamera
                        local viewport = cameraNow and cameraNow.ViewportSize or Vector2.new(800, 600)
                        local point = handle.Instance.AbsolutePosition
                        local x = math.clamp(point.X + 12, 8, math.max(8, viewport.X - 266))
                        local y = math.clamp(point.Y + handle.Instance.AbsoluteSize.Y + 5, 8, math.max(8, viewport.Y - 82))
                        tooltip.Position = UDim2.fromOffset(x, y)
                        tooltip.Visible = true
                    end
                    handle.Instance.MouseEnter:Connect(showTooltip)
                    handle.Instance.MouseLeave:Connect(function() tooltip.Visible = false end)
                    if UserInputService.TouchEnabled then
                        handle.Instance.InputBegan:Connect(function(input)
                            if input.UserInputType == Enum.UserInputType.Touch then
                                showTooltip()
                                task.delay(2.4, function() if tooltip.Parent then tooltip.Visible = false end end)
                            end
                        end)
                    end
                end
                activeControlContainer = previousContainer

                local dependency = source.ShowWhen or source.SubOf
                if type(dependency) == "table" and type(dependency.Get) == "function" and handle.Instance and handle.Instance:IsA("GuiObject") then
                    local function updateVisible()
                        local dependencyValue = dependency:Get()
                        if type(dependencyValue) == "boolean" then handle.Instance.Visible = dependencyValue end
                    end
                    if type(dependency.Subscribe) == "function" then
                        handle._dependencyConnection = dependency:Subscribe(updateVisible)
                    end
                    updateVisible()
                end
