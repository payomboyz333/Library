function ObsidianGlassEngine:RegisterTheme(name, palette)
    if type(name) ~= "string" or name == "" or type(palette) ~= "table" then
        return false, "A theme name and palette table are required"
    end
    local fields = { Accent = "primary", Bright = "primaryHover", Deep = "primaryPressed", Tint = "surfaceHover" }
    local normalized = {}
    for publicKey, internalKey in pairs(fields) do
        local color = palette[publicKey] or palette[internalKey]
        if typeof(color) ~= "Color3" then
            return false, "Theme palette requires Color3 fields: Accent, Bright, Deep, Tint"
        end
        normalized[publicKey] = color
    end
    local particle, particleError = normalizeParticleProfile(palette.Particle, normalized.Accent, normalized.Bright)
    if not particle then return false, particleError end
    normalized.Particle = particle
    THEME_PRESETS[name] = normalized
    return true
end

function ObsidianGlassEngine:RemoveTheme(name)
    name = THEME_ALIASES[name] or name
    if name == "แดงเปลวเพลิง" then return false, "The default theme cannot be removed" end
    if not THEME_PRESETS[name] then return false, "Unknown theme" end
    THEME_PRESETS[name] = nil
    if self.CurrentTheme == name then self:SetTheme("Crimson") end
    return true
end

function ObsidianGlassEngine:GetThemePalette(name)
    name = name or self.CurrentTheme
    name = THEME_ALIASES[name] or name
    local palette = THEME_PRESETS[name]
    if not palette then return nil end
    return {
        Accent = palette.Accent,
        Bright = palette.Bright,
        Deep = palette.Deep,
        Tint = palette.Tint,
        Particle = self:DeepCopy(palette.Particle),
    }
end

function ObsidianGlassEngine:SetTheme(theme)
    local requestedName = type(theme) == "string" and theme or nil
    local resolvedName = requestedName and (THEME_ALIASES[requestedName] or requestedName) or nil
    local preset = resolvedName and THEME_PRESETS[resolvedName] or theme
    if type(preset) ~= "table" then return false, "Unknown theme" end

    local oldColors = copyThemeColors()
    local accent = preset.Accent or preset.primary
    local bright = preset.Bright or preset.primaryHover or accent
    local deep = preset.Deep or preset.primaryPressed or accent
    local tint = preset.Tint or preset.surfaceHover or COLORS.surfaceHover
    if typeof(accent) ~= "Color3" or typeof(bright) ~= "Color3" or typeof(deep) ~= "Color3" or typeof(tint) ~= "Color3" then
        return false, "Theme Accent, Bright, Deep, and Tint values must be Color3"
    end
    local particle, particleError = normalizeParticleProfile(preset.Particle, accent, bright)
    if not particle then return false, particleError end

    COLORS.primary = accent
    COLORS.primaryHover = bright
    COLORS.primaryPressed = deep
    COLORS.cyan = accent
    COLORS.lightningGlow = accent
    COLORS.shellStroke = deep
    COLORS.divider = tint
    COLORS.surfaceHover = tint
    ACTIVE_THEME_PROFILE = {
        Accent = accent,
        Bright = bright,
        Deep = deep,
        Tint = tint,
        Particle = particle,
    }
    self.CurrentTheme = resolvedName or "Custom"

    local colorProperties = { "BackgroundColor3", "TextColor3", "TextStrokeColor3", "ImageColor3", "BorderColor3", "Color", "ScrollBarImageColor3" }
    for gui in pairs(liveGuis) do
        if gui and gui.Parent then
            for _, instance in ipairs(gui:GetDescendants()) do
                if instance:IsA("UIGradient") then
                    local points = {}
                    for _, point in ipairs(instance.Color.Keypoints) do
                        local pointColor = point.Value
                        for _, key in ipairs(THEME_COLOR_KEYS) do
                            if pointColor == oldColors[key] then pointColor = COLORS[key]; break end
                        end
                        points[#points + 1] = ColorSequenceKeypoint.new(point.Time, pointColor)
                    end
                    pcall(function() instance.Color = ColorSequence.new(points) end)
                end
                for _, property in ipairs(colorProperties) do
                    local ok, value = pcall(function() return instance[property] end)
                    if ok then
                        for _, key in ipairs(THEME_COLOR_KEYS) do
                            if value == oldColors[key] then
                                pcall(function() instance[property] = COLORS[key] end)
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    return true
end
