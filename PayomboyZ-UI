        local speed = math.clamp((tonumber(profile.Speed) or 0.025) * 0.62, 0.008, 0.045)
        local drift = math.clamp(tonumber(profile.Drift) or 0.008, 0, 0.08)
        local sway = math.clamp(tonumber(profile.Sway) or 0.01, 0, 0.08)
        local lifetime = math.clamp(tonumber(profile.Lifetime) or 6.5, 3, 12)
        local style = profile.Style or "Ember"
        local styleMotion = PARTICLE_STYLE_MOTION[style] or 1
        local spin = math.clamp(tonumber(profile.Spin) or 16, 0, 45)
