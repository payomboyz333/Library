[5. โค้ดต้นแบบระบบ PARTICLE ฤดูกาล (LUAU STANDALONE ENGINE)]
================================================================================
ด้านล่างนี้คือโค้ดโมดูลที่สามารถนำไปวางครอบ UI ของคุณได้ทันที:

```lua
-- ============================================================================
-- PAYOMBOYZ SEASONAL PARTICLE ENGINE
-- Drop-in module for Roblox Executor UIs (Zero FPS Lag)
-- ============================================================================
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local SeasonalEngine = {}
SeasonalEngine.__index = SeasonalEngine

function SeasonalEngine.new(parentFrame)
    local self = setmetatable({}, SeasonalEngine)
    self.Parent = parentFrame
    self.Particles = {}
    self.MaxParticles = 30
    self.Running = false
    self.CurrentSeason = "Auto"
    
    -- Canvas Container
    local container = Instance.new("Frame")
    container.Name = "SeasonalParticleCanvas"
    container.Size = UDim2.fromScale(1, 1)
    container.BackgroundTransparency = 1
    container.ClipsDescendants = true
    container.ZIndex = 2
    container.Parent = parentFrame
    self.Container = container

    self:DetermineSeason()
    self:InitPool()
    return self
end

function SeasonalEngine:DetermineSeason()
    if self.CurrentSeason ~= "Auto" then return end
    local m = os.date("*t").month
    if m >= 3 and m <= 5 then
        self.ActiveSeason = "Spring"
    elseif m >= 6 and m <= 8 then
        self.ActiveSeason = "Summer"
    elseif m >= 9 and m <= 11 then
        self.ActiveSeason = "Autumn"
    else
        self.ActiveSeason = "Winter"
    end
end

function SeasonalEngine:SetSeason(seasonName)
    self.CurrentSeason = seasonName
    if seasonName == "Auto" then
        self:DetermineSeason()
    else
        self.ActiveSeason = seasonName
    end
    self:RefreshPalette()
end

function SeasonalEngine:RefreshPalette()
    local s = self.ActiveSeason
    for _, p in ipairs(self.Particles) do
        if s == "Spring" then
            p.Gui.BackgroundColor3 = (math.random() > 0.5) and Color3.fromRGB(255, 183, 197) or Color3.fromRGB(255, 140, 170)
            p.Gui.Size = UDim2.fromOffset(math.random(6, 9), math.random(8, 12))
            p.Corner.CornerRadius = UDim.new(1, 0)
        elseif s == "Summer" then
            p.Gui.BackgroundColor3 = (math.random() > 0.5) and Color3.fromRGB(255, 215, 80) or Color3.fromRGB(255, 100, 50)
            p.Gui.Size = UDim2.fromOffset(math.random(4, 7), math.random(4, 7))
            p.Corner.CornerRadius = UDim.new(1, 0)
        elseif s == "Autumn" then
            p.Gui.BackgroundColor3 = (math.random() > 0.5) and Color3.fromRGB(235, 55, 45) or Color3.fromRGB(225, 120, 25)
            p.Gui.Size = UDim2.fromOffset(math.random(7, 11), math.random(7, 11))
            p.Corner.CornerRadius = UDim.new(0, 3)
        elseif s == "Winter" then
            p.Gui.BackgroundColor3 = (math.random() > 0.5) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(195, 230, 255)
            p.Gui.Size = UDim2.fromOffset(math.random(4, 8), math.random(4, 8))
            p.Corner.CornerRadius = UDim.new(1, 0)
        end
    end
end

function SeasonalEngine:InitPool()
    for i = 1, self.MaxParticles do
        local f = Instance.new("Frame")
        f.BorderSizePixel = 0
        f.BackgroundTransparency = math.random(20, 55) / 100
        local c = Instance.new("UICorner")
        c.Parent = f
        f.Parent = self.Container

        local data = {
            Gui = f,
            Corner = c,
            X = math.random(0, 700),
            Y = math.random(-50, 480),
            SpeedX = 0,
            SpeedY = 0,
            WobbleSpeed = math.random(15, 35) / 10,
            WobbleDist = math.random(15, 40),
            Phase = math.random() * math.pi * 2,
            RotSpeed = math.random(-60, 60)
        }
        table.insert(self.Particles, data)
    end
    self:RefreshPalette()
end

function SeasonalEngine:Start()
    if self.Running then return end
    self.Running = true

    self.Conn = RunService.RenderStepped:Connect(function(dt)
        local w = self.Container.AbsoluteSize.X
        local h = self.Container.AbsoluteSize.Y
        if w <= 0 or h <= 0 then return end
        
        local s = self.ActiveSeason
        for _, p in ipairs(self.Particles) do
            p.Phase = p.Phase + dt * p.WobbleSpeed
            local wobble = math.sin(p.Phase) * p.WobbleDist

            if s == "Spring" then
                p.X = p.X + (20 + wobble * 0.2) * dt
                p.Y = p.Y + (30 + math.abs(wobble) * 0.3) * dt
                p.Gui.Rotation = p.Gui.Rotation + p.RotSpeed * dt
            elseif s == "Summer" then
                p.X = p.X + wobble * 0.4 * dt
                p.Y = p.Y - (22 + math.cos(p.Phase) * 10) * dt
            elseif s == "Autumn" then
                p.X = p.X + (25 + wobble * 0.5) * dt
                p.Y = p.Y + (45 + math.abs(wobble) * 0.5) * dt
                p.Gui.Rotation = p.Gui.Rotation + (p.RotSpeed * 1.5) * dt
            elseif s == "Winter" then
                p.X = p.X + wobble * 0.3 * dt
                p.Y = p.Y + (25 + math.abs(wobble) * 0.2) * dt
            end

            -- Wrap bounds
            if p.Y > h + 20 then
                p.Y = -20
                p.X = math.random(0, w)
            elseif p.Y < -20 then
                p.Y = h + 20
                p.X = math.random(0, w)
            end
            if p.X > w + 20 then
                p.X = -20
            elseif p.X < -20 then
                p.X = w + 20
            end

            p.Gui.Position = UDim2.fromOffset(p.X, p.Y)
        end
    end)
end

function SeasonalEngine:Stop()
    if self.Conn then self.Conn:Disconnect(); self.Conn = nil end
    self.Running = false
end

function SeasonalEngine:Destroy()
    self:Stop()
    if self.Container then self.Container:Destroy() end
end

return SeasonalEngine
```

