    local function detectExecutorName()
        local environments = { _G }
        if type(getfenv) == "function" then
            local ok, environment = pcall(getfenv, 0)
            if ok and type(environment) == "table" then environments[#environments + 1] = environment end
        end
        if type(getgenv) == "function" then
            local ok, environment = pcall(getgenv)
            if ok and type(environment) == "table" then environments[#environments + 1] = environment end
        end
        for _, environment in ipairs(environments) do
            for _, detectorName in ipairs({ "identifyexecutor", "getexecutorname" }) do
                local ok, detector = pcall(function() return environment[detectorName] end)
                if ok and type(detector) == "function" then
                    local callOk, name, version = pcall(detector)
                    if callOk and type(name) == "string" and name ~= "" then
                        name = name:gsub("[%c]", " "):sub(1, 25)
                        if type(version) == "string" and version ~= "" then
                            name = name .. "  /  " .. version:gsub("[%c]", " "):sub(1, 10)
                        end
                        return name
                    end
                end
            end
        end
        return RunService:IsStudio() and "Roblox Studio" or "Not detected"
    end

