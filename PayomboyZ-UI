            shape.Name = name
            shape.AnchorPoint = Vector2.new(0.5, 0.5)
            shape.Size = size
            shape.Position = position
            shape.BackgroundColor3 = shapeColor or color
            shape.BackgroundTransparency = 1
            shape.BorderSizePixel = 0
            shape.Rotation = rotation or 0
            shape.ZIndex = 4
            shape.Parent = root
            local property = className == "ImageLabel" and "ImageTransparency" or "BackgroundTransparency"
            if className == "ImageLabel" then shape.ImageTransparency = 1 end
            opacityTargets[#opacityTargets + 1] = { Object = shape, Property = property, Weight = weight or 1 }
            return shape
        end
        local function round(shape)
            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(1, 0)
