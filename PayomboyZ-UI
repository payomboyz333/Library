                    sprite.Position = UDim2.new(math.clamp(driftX, 0.08, 0.92), 0, state.Y, 0)
                    sprite.Rotation = (state.Phase * 30 + state.Age * (spin + state.RotationSpeed * styleMotion)) % 360
                    local particleOpacity = opacity * phase
                    local sizePulse = state.Scale * (0.88 + phase * 0.18)
                    sprite.Size = UDim2.fromOffset(30 * sizePulse, 30 * sizePulse)
                    for _, target in ipairs(state.OpacityTargets) do
