        title.Font = Enum.Font.GothamBold
        title.TextSize = 12
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextTruncate = Enum.TextTruncate.AtEnd
        title.Parent = toast
        local close = Instance.new("TextButton")
        close.Size = UDim2.fromOffset(22, 22)
        close.Position = UDim2.new(1, -29, 0, 8)
        close.BackgroundColor3 = COLORS.surfaceRaised
        close.BorderSizePixel = 0
        close.Text = "×"
        close.TextColor3 = COLORS.textMuted
        close.Font = Enum.Font.GothamBold
        close.TextSize = 13
        close.Parent = toast
        local closeCorner = Instance.new("UICorner", close)
        closeCorner.CornerRadius = UDim.new(0, 6)
        local description = Instance.new("TextLabel")
        description.Name = "Content"
        description.Size = UDim2.new(1, -62, 0, 34)
        description.Position = UDim2.fromOffset(47, 30)
        description.BackgroundTransparency = 1
        description.Text = tostring(cfg.Content or cfg.Description or "")
        description.TextColor3 = COLORS.text
        description.Font = Enum.Font.Gotham
        description.TextSize = 10
        description.TextWrapped = true
        description.TextXAlignment = Enum.TextXAlignment.Left
        description.TextYAlignment = Enum.TextYAlignment.Top
        description.Parent = toast
        local lifetime = Instance.new("Frame")
        lifetime.Name = "Lifetime"
        lifetime.Size = UDim2.new(1, 0, 0, 2)
        lifetime.Position = UDim2.new(0, 0, 1, -2)
        lifetime.BackgroundColor3 = tone
        lifetime.BorderSizePixel = 0
        lifetime.Parent = toast
        local result
        local dismissed = false
        result = { Instance = toast, Id = cfg.Id or tostring(os.clock()), Type = kind }
        function result:Update(nextCfg)
            if type(nextCfg) ~= "table" or dismissed then return false end
            if nextCfg.Title ~= nil then title.Text = tostring(nextCfg.Title) end
            if nextCfg.Content ~= nil then description.Text = tostring(nextCfg.Content) end
            return true
        end
        function result:Dismiss()
            if dismissed then return end
            dismissed = true
            for index, handle in ipairs(notificationHandles) do
                if handle == result then table.remove(notificationHandles, index); break end
            end
            if toast.Parent then
                local tween = TweenService:Create(toast, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 0),
                })
                tween:Play()
                tween.Completed:Connect(function() if toast then toast:Destroy() end end)
            end
        end
        close.Activated:Connect(function() result:Dismiss() end)
        if type(cfg.Action) == "table" and type(cfg.Action.Callback) == "function" then
            local action = Instance.new("TextButton")
            action.Name = "Action"
            action.Size = UDim2.new(1, -62, 0, 20)
            action.Position = UDim2.fromOffset(47, 64)
            action.BackgroundColor3 = COLORS.surfaceRaised
            action.BorderSizePixel = 0
            action.Text = tostring(cfg.Action.Name or "Open")
            action.TextColor3 = tone
            action.Font = Enum.Font.GothamBold
            action.TextSize = 9
            action.Parent = toast
            local actionCorner = Instance.new("UICorner", action)
            actionCorner.CornerRadius = UDim.new(0, 5)
            action.Activated:Connect(function()
                pcall(cfg.Action.Callback)
                if cfg.Action.Dismiss ~= false then result:Dismiss() end
            end)
        end
        notificationHandles[#notificationHandles + 1] = result
        while #notificationHandles > 5 do notificationHandles[1]:Dismiss() end
        playClickSound()
        local duration = math.max(tonumber(cfg.Duration) or 4, 0)
        if duration > 0 then
            TweenService:Create(lifetime, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
                Size = UDim2.new(0, 0, 0, 2),
            }):Play()
            task.delay(duration, function() if not dismissed then result:Dismiss() end end)
        end
        return result
    end)
    if ok then return toastOrError end
    return nil, tostring(toastOrError)
end

function ObsidianGlassEngine:DismissNotifications()
    for index = #notificationHandles, 1, -1 do
        local handle = notificationHandles[index]
        if handle then handle:Dismiss() end
    end
end

function ObsidianGlassEngine:GetNotificationCount()
    return #notificationHandles
end

function ObsidianGlassEngine:CreateWindow(cfg)
    cfg = cfg or {}
    self.Options = {}
    local trackedConnections = {}
    local trackedThreads = {}
    local unloadWindow
    local WindowObj
    local configuredEffects = type(cfg.Effects) == "table" and cfg.Effects or {}
    local touchOnly = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    local effectState = {
        Lightning = configuredEffects.Lightning == true or cfg.Lightning == true,
        Sparks = configuredEffects.Sparks ~= false and cfg.Sparks ~= false,
        CapsuleSparks = configuredEffects.CapsuleSparks == true or cfg.CapsuleSparks == true,
        Intro = configuredEffects.Intro ~= false and cfg.Intro ~= false,
        Sound = configuredEffects.Sound ~= false and cfg.Sound ~= false,
        SparkCount = math.clamp(tonumber(configuredEffects.SparkCount or cfg.SparkCount) or (touchOnly and 2 or 3), 0, 7),
        CapsuleSparkCount = math.clamp(tonumber(configuredEffects.CapsuleSparkCount or cfg.CapsuleSparkCount) or (touchOnly and 0 or 1), 0, 2),
    }
    local motionMode = cfg.Motion or "Full"
    if motionMode ~= "Full" and motionMode ~= "Subtle" and motionMode ~= "Off" then motionMode = "Full" end
    self.SoundsEnabled = effectState.Sound

    local function animate(target, info, properties)
        if motionMode == "Off" then
            for property, value in pairs(properties) do pcall(function() target[property] = value end) end
            return nil
        end
        local factor = motionMode == "Subtle" and 0.55 or 1
        local scaledInfo = TweenInfo.new(info.Time * factor, info.EasingStyle, info.EasingDirection, info.RepeatCount, info.Reverses, info.DelayTime * factor)
        local tween = TweenService:Create(target, scaledInfo, properties)
        tween:Play()
        return tween
    end

    local function sharpenText(label, transparency)
        if not label or not label:IsA("TextLabel") and not label:IsA("TextButton") and not label:IsA("TextBox") then return end
        label.TextStrokeColor3 = COLORS.backdrop
        label.TextStrokeTransparency = transparency or 0.58
    end

    local function addAnimeEdge(parent, usePanelMotion, explicitBackingColor)
        -- Only major panels get the cut silhouette. Repeating slash art on every
        -- control created a noisy wall of lines and hundreds of extra Instances.
        local majorPanel = explicitBackingColor ~= nil
            or parent.Name == "MainShell"
            or parent.Name == "UserPanel"
            or parent.Name == "QuickUtilitiesCard"
            or parent.Name == "LibraryStatusCard"
            or parent.Name == "MetricsBox"
            or string.match(parent.Name, "^SectionCard_") ~= nil
        local backingColor = explicitBackingColor or COLORS.shell
        if not explicitBackingColor then
            local ancestor = parent.Parent
            while ancestor and ancestor:IsA("GuiObject") do
                if ancestor.BackgroundTransparency < 0.95 then
                    backingColor = ancestor.BackgroundColor3
                    break
                end
                ancestor = ancestor.Parent
            end
        end

        if explicitBackingColor then
            parent.ClipsDescendants = false
        elseif majorPanel then
            parent.ClipsDescendants = true
        end
        local outline
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("UICorner") then
                child:Destroy()
            elseif child:IsA("UIStroke") then
                outline = child
            end
        end
        if not outline and not explicitBackingColor then
            outline = Instance.new("UIStroke")
            outline.Parent = parent
        end
        if outline then
            outline.Color = majorPanel and COLORS.primary or COLORS.glassRaised
            outline.Thickness = majorPanel and 1.5 or 1
            outline.Transparency = majorPanel and 0.08 or 0.32
        end

        if majorPanel then
            local cuts = {
                { "TopLeft", UDim2.fromOffset(0, 0), -45, UDim2.fromOffset(7, 7), -45 },
                { "TopRight", UDim2.new(1, 0, 0, 0), 45, UDim2.new(1, -7, 0, 7), 45 },
                { "BottomRight", UDim2.new(1, 0, 1, 0), -45, UDim2.new(1, -7, 1, -7), -45 },
                { "BottomLeft", UDim2.new(0, 0, 1, 0), 45, UDim2.new(0, 7, 1, -7), 45 },
            }
            for _, cut in ipairs(cuts) do
                local mask = Instance.new("Frame")
                mask.Name = "ComicCutMask_" .. cut[1]
                mask.AnchorPoint = Vector2.new(0.5, 0.5)
                mask.Position = cut[2]
                mask.Size = UDim2.fromOffset(explicitBackingColor and 40 or 22, explicitBackingColor and 40 or 22)
                mask.Rotation = cut[3]
                mask.BackgroundColor3 = backingColor
                mask.BorderSizePixel = 0
                mask.ZIndex = parent.ZIndex + 2
                mask.Parent = parent

                local bevel = Instance.new("Frame")
                bevel.Name = "ComicCutInk_" .. cut[1]
                bevel.AnchorPoint = Vector2.new(0.5, 0.5)
                bevel.Position = cut[4]
                bevel.Size = UDim2.fromOffset(explicitBackingColor and 40 or 22, 1.7)
                bevel.Rotation = cut[5]
                bevel.BackgroundColor3 = COLORS.primary
                bevel.BorderSizePixel = 0
                bevel.ZIndex = parent.ZIndex + 3
                bevel.Parent = parent
            end
        end

        if majorPanel and outline then
            parent.MouseEnter:Connect(function() outline.Thickness = 1.9; outline.Transparency = 0 end)
            parent.MouseLeave:Connect(function() outline.Thickness = 1.5; outline.Transparency = 0.08 end)
        end
    end

    if cfg.Theme then self:SetTheme(cfg.Theme) end
    local parentGui = getSafeParentGui()
    if parentGui:FindFirstChild("ObsidianGlass2_UI") then
        parentGui.ObsidianGlass2_UI:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "ObsidianGlass2_UI"
    gui:SetAttribute("PayomboyZLibraryOwned", true)
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 99999
    gui.Parent = parentGui
    liveGuis[gui] = true

    local unloaded = false
    unloadWindow = function()
        if unloaded then return end
        unloaded = true
        for _, option in pairs(ObsidianGlassEngine.Options) do
            if type(option) == "table" and option.Active == true and type(option.SetActive) == "function" then
                pcall(option.SetActive, option, false)
            end
            if type(option) == "table" and option.Value == true and type(option.SetValue) == "function" then
                pcall(option.SetValue, option, false)
            end
        end
        for _, connection in ipairs(trackedConnections) do pcall(function() connection:Disconnect() end) end
        table.clear(trackedConnections)
        for _, thread in ipairs(trackedThreads) do pcall(task.cancel, thread) end
        table.clear(trackedThreads)
        if type(cfg.OnUnload) == "function" then pcall(cfg.OnUnload) end
        liveGuis[gui] = nil
        if gui and gui.Parent then gui:Destroy() end
    end

    local plasmaSparkFrames = {}
    local capsuleSparkFrames = {}

    local uiScale = Instance.new("UIScale")
    
    -- 📱 AUTOMATIC MOBILE RESPONSIVE SCALING ENGINE
    local camera = workspace.CurrentCamera
    local function updateScale()
        if camera and camera.ViewportSize then
            local vp = camera.ViewportSize
            local targetWidth, targetHeight = 920, 600
            local scaleX = (vp.X - 24) / targetWidth
            local scaleY = (vp.Y - 24) / targetHeight
            -- Narrow phones need to scale below the old 0.45 floor or the 920px
            -- shell spills past the edges. Keep a usable floor, then reflow cards.
            local calcScale = math.clamp(math.min(scaleX, scaleY), 0.32, 1.0)
            uiScale.Scale = calcScale
        end
    end
    updateScale()
    if camera then
        table.insert(trackedConnections, camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale))
    end
    uiScale.Parent = gui

    -- Dark anime shell; the opening sequence expands from this compact frame.
    local shell = Instance.new("Frame")
    shell.Name = "MainShell"
    shell.Size = UDim2.fromOffset(520, 150)
    shell.AnchorPoint = Vector2.new(0.5, 0.5)
    shell.Position = UDim2.new(0.5, 0, 0.5, 0)
    shell.BackgroundColor3 = COLORS.shell
    shell.BackgroundTransparency = 0.08
    shell.BorderSizePixel = 0
    shell.ClipsDescendants = false
    shell.Parent = gui

    local shellGradient = Instance.new("UIGradient")
    shellGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(20, 7, 12)),
        ColorSequenceKeypoint.new(0.42, COLORS.shell),
        ColorSequenceKeypoint.new(0.76, Color3.fromRGB(10, 11, 15)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 7, 12)),
    })
    shellGradient.Rotation = -12
    shellGradient.Parent = shell

    -- Asymmetric perimeter: the top brand tab and lower-right notch deliberately
    -- interrupt the rectangle. Segment frames let the silhouette extend beyond
    -- the shell without drawing a standard rectangular UIStroke.
    local outerContour = {
        { 0, 0.18 }, { 0, 0.12 }, { 0.08, 0.04 }, { 0.28, 0.04 },
        { 0.55, 0.04 }, { 0.60, -0.025 }, { 0.81, -0.025 },
        { 0.855, 0.04 }, { 0.95, 0.04 }, { 1, 0.11 },
        { 1, 0.60 }, { 0.965, 0.67 }, { 1, 0.73 },
        { 1, 0.89 }, { 0.94, 0.96 }, { 0.71, 0.96 },
        { 0.66, 1 }, { 0.24, 1 }, { 0.19, 0.96 },
        { 0.06, 0.96 }, { 0, 0.89 }, { 0, 0.24 },
    }
    local outerFrameLines = {}
    local showContourImmediately = not effectState.Intro or motionMode == "Off"
    local function addOuterLine(pointA, pointB, color, thickness)
        local ax, ay = pointA[1] * 920, pointA[2] * 600
        local bx, by = pointB[1] * 920, pointB[2] * 600
        local dx, dy = bx - ax, by - ay
        local line = Instance.new("Frame")
        line.Name = "OuterComicContour"
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Position = UDim2.new((pointA[1] + pointB[1]) * 0.5, 0, (pointA[2] + pointB[2]) * 0.5, 0)
        line.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), thickness or 2.6)
        line.Rotation = math.deg(math.atan2(dy, dx))
        line.BackgroundColor3 = color or COLORS.primary
        line.BorderSizePixel = 0
        line.ZIndex = 4
        line.Visible = showContourImmediately
        line.Parent = shell
        outerFrameLines[#outerFrameLines + 1] = line
        return line
    end
    local shellStroke
    for index, point in ipairs(outerContour) do
        local nextPoint = outerContour[index % #outerContour + 1]
        local color = (index == 5 or index == 6 or index == 7) and COLORS.primaryHover or COLORS.primary
        local line = addOuterLine(point, nextPoint, color, 2.6)
        if index == 3 then shellStroke = line end
    end
    addAnimeEdge(shell, false, COLORS.backdrop)
    local notchMask = Instance.new("Frame")
    notchMask.Name = "OuterRightImpactCut"
    notchMask.AnchorPoint = Vector2.new(0.5, 0.5)
    notchMask.Position = UDim2.new(1, -18, 0.70, 0)
    notchMask.Size = UDim2.fromOffset(28, 28)
    notchMask.Rotation = 45
    notchMask.BackgroundColor3 = COLORS.backdrop
    notchMask.BorderSizePixel = 0
    notchMask.ZIndex = 3
    notchMask.Parent = shell

    -- A low-cost ink gradient and two halftone clusters give the backdrop texture
    -- without the distracting spokes that converged behind every page.
    local comicBurstLayer = Instance.new("Frame")
    comicBurstLayer.Name = "ComicBurstLayer"
    comicBurstLayer.Size = UDim2.fromScale(1, 1)
    comicBurstLayer.BackgroundTransparency = 1
    comicBurstLayer.BorderSizePixel = 0
    comicBurstLayer.ClipsDescendants = true
    comicBurstLayer.ZIndex = 2
    comicBurstLayer.Parent = shell
    for index = 1, 12 do
        local dot = Instance.new("Frame")
        dot.Name = "HalftoneDot"
        dot.Size = UDim2.fromOffset(3, 3)
        dot.Position = index <= 6
            and UDim2.new(0.84 + ((index - 1) % 3) * 0.024, 0, 0.09 + math.floor((index - 1) / 3) * 0.018, 0)
            or UDim2.new(0.10 + ((index - 7) % 3) * 0.024, 0, 0.87 + math.floor((index - 7) / 3) * 0.018, 0)
        dot.BackgroundColor3 = index % 3 == 0 and COLORS.primary or COLORS.textFaint
        dot.BackgroundTransparency = 0.76
        dot.BorderSizePixel = 0
        dot.ZIndex = 2
        dot.Parent = comicBurstLayer
    end

    -- ⚡ AMBIENT LIGHTNING FLASH (ZIndex 80 - OVER PANELS & CARDS)
    local ambientLightningFlash = Instance.new("Frame")
    ambientLightningFlash.Name = "AmbientLightningFlash"
    ambientLightningFlash.Size = UDim2.fromScale(1, 1)
    ambientLightningFlash.BackgroundColor3 = COLORS.lightningGlow
    ambientLightningFlash.BackgroundTransparency = 1
    ambientLightningFlash.BorderSizePixel = 0
    ambientLightningFlash.Active = false
    ambientLightningFlash.ZIndex = 2
    ambientLightningFlash.Parent = shell
    local fCorner = Instance.new("UICorner")
    fCorner.CornerRadius = UDim.new(0, 18)
    fCorner.Parent = ambientLightningFlash

    -- ⚡ CRIMSON LIGHTNING & ELECTRIC ARCS ENGINE (ZIndex 85 - IN FRONT OF ALL UI)
    local lightningLayer = Instance.new("Frame")
    lightningLayer.Name = "LightningLayer"
    lightningLayer.Size = UDim2.fromScale(1, 1)
    lightningLayer.BackgroundTransparency = 1
    lightningLayer.BorderSizePixel = 0
    lightningLayer.ClipsDescendants = true
    lightningLayer.Active = false
    lightningLayer.ZIndex = 3
    lightningLayer.Parent = shell

    -- Procedural High-Voltage Crimson Lightning Bolt Strike Function
    local function strikeLightning(targetFrame, numSegments)
        if not effectState.Lightning then return end
        if not targetFrame or not targetFrame.Parent then return end
        local w = targetFrame.AbsoluteSize.X
        local h = targetFrame.AbsoluteSize.Y
        if w <= 20 or h <= 20 then
            w = 920
            h = 600
        end

        local startX = math.random(30, math.max(50, math.floor(w - 30)))
        local startY = math.random(4, 20)
        local endX = math.clamp(startX + math.random(-240, 240), 25, w - 25)
        local endY = math.random(math.floor(h * 0.45), math.floor(h * 0.94))

        local segCount = numSegments or math.random(6, 9)
        local pts = {}
        table.insert(pts, Vector2.new(startX, startY))
        for i = 1, segCount - 1 do
            local alpha = i / segCount
            local midX = startX + (endX - startX) * alpha + math.random(-42, 42)
            local midY = startY + (endY - startY) * alpha + math.random(-20, 20)
            table.insert(pts, Vector2.new(midX, midY))
        end
        table.insert(pts, Vector2.new(endX, endY))

        -- Optional Jagged Electric Fork Branch
        local forkPts = {}
        if #pts >= 4 and math.random(1, 10) >= 3 then
            local forkStartIndex = math.random(2, #pts - 2)
            local forkOrigin = pts[forkStartIndex]
            local forkEndX = math.clamp(forkOrigin.X + math.random(-120, 120), 20, w - 20)
            local forkEndY = math.clamp(forkOrigin.Y + math.random(35, 110), 35, h - 20)
            local forkMidX = (forkOrigin.X + forkEndX) / 2 + math.random(-25, 25)
            local forkMidY = (forkOrigin.Y + forkEndY) / 2 + math.random(-14, 14)
            table.insert(forkPts, forkOrigin)
            table.insert(forkPts, Vector2.new(forkMidX, forkMidY))
            table.insert(forkPts, Vector2.new(forkEndX, forkEndY))
        end

        local segFrames = {}
        local function renderSegments(pointList, coreColor, strokeColor, thickness, zIdx)
            for i = 1, #pointList - 1 do
                local p1 = pointList[i]
                local p2 = pointList[i + 1]
                local diff = p2 - p1
                local len = diff.Magnitude
                local angle = math.deg(math.atan2(diff.Y, diff.X))
                local mid = (p1 + p2) / 2

                local seg = Instance.new("Frame")
                seg.Name = "CrimsonBoltSeg"
                seg.AnchorPoint = Vector2.new(0.5, 0.5)
                seg.Position = UDim2.fromOffset(mid.X, mid.Y)
                seg.Size = UDim2.fromOffset(len + 1, thickness or 2.8)
                seg.Rotation = angle
                seg.BackgroundColor3 = coreColor or Color3.fromRGB(255, 245, 252)
                seg.BorderSizePixel = 0
                seg.Active = false
        seg.ZIndex = zIdx or 4
                seg.Parent = targetFrame

                local st = Instance.new("UIStroke")
                st.Color = strokeColor or COLORS.lightningGlow
                st.Thickness = 3.2
                st.Transparency = 0.05
                st.Parent = seg

                table.insert(segFrames, seg)
            end
        end

        -- Render primary bolt & secondary fork
        renderSegments(pts, Color3.fromRGB(255, 248, 252), COLORS.lightningGlow, 2.2, 4)
        if #forkPts > 1 then
            renderSegments(forkPts, Color3.fromRGB(255, 220, 235), COLORS.primaryHover, 1.6, 4)
        end

        -- Flash ambient crimson glow across entire shell
        if effectState.Lightning and ambientLightningFlash and ambientLightningFlash.Parent then
            ambientLightningFlash.BackgroundTransparency = 0.82
            task.delay(0.05, function()
                if ambientLightningFlash and ambientLightningFlash.Parent then
        animate(ambientLightningFlash, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 })
                end
            end)
        end

        -- Multi-stage electric crackle flicker & fade
        task.delay(0.06, function()
            for _, seg in ipairs(segFrames) do
                if seg and seg.Parent then
                    seg.BackgroundTransparency = 0.3
                end
            end
        end)
        task.delay(0.12, function()
            for _, seg in ipairs(segFrames) do
                if seg and seg.Parent then
                    seg.BackgroundTransparency = 0.05
                end
            end
        end)
        task.delay(0.18, function()
            for _, seg in ipairs(segFrames) do
                if seg and seg.Parent then
                    animate(seg, TweenInfo.new(0.08), { BackgroundTransparency = 1 })
                end
            end
        end)
        task.delay(0.28, function()
            for _, seg in ipairs(segFrames) do
                if seg and seg.Parent then
                    seg:Destroy()
                end
            end
        end)
    end

    -- Seven pooled comic particles have a permanent hue-to-silhouette pairing.
    -- Their palette follows the active theme, but particle identity never cycles.
    local sparkTexture = "rbxasset://textures/particles/sparkles_main.dds"
    local PARTICLE_SPECTRUM = {
        Color3.fromRGB(255, 49, 77), Color3.fromRGB(255, 119, 51),
        Color3.fromRGB(255, 212, 71), Color3.fromRGB(112, 238, 104),
        Color3.fromRGB(62, 221, 218), Color3.fromRGB(77, 133, 255),
        Color3.fromRGB(190, 104, 255),
