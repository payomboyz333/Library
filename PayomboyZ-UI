local function normalizeParticleProfile(source, accent, bright)
    source = type(source) == "table" and source or {}
    local colors = {}
    if type(source.Colors) == "table" then
        for _, color in ipairs(source.Colors) do
            if typeof(color) ~= "Color3" then return nil, "Particle.Colors entries must be Color3" end
            colors[#colors + 1] = color
            if #colors == 4 then break end
        end
    end
    if #colors == 0 then colors = { bright or accent, accent or bright } end
    local direction = tonumber(source.Direction) or -1
    return {
        Glyph = type(source.Glyph) == "string" and source.Glyph ~= "" and string.sub(source.Glyph, 1, 4) or "✦",
        Style = PARTICLE_STYLES[source.Style] and source.Style or "Ember",
        Direction = direction >= 0 and 1 or -1,
        Speed = math.clamp(tonumber(source.Speed) or 0.025, 0.004, 0.08),
        Drift = math.clamp(tonumber(source.Drift) or 0.008, 0, 0.08),
        Sway = math.clamp(tonumber(source.Sway) or 0.01, 0, 0.08),
        Spin = math.clamp(tonumber(source.Spin) or 24, 0, 180),
        Lifetime = math.clamp(tonumber(source.Lifetime) or 6.5, 3, 12),
        Opacity = math.clamp(tonumber(source.Opacity) or 0.4, 0.12, 0.72),
        Colors = colors,
    }
end
