            title.TextSize = 12
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.ZIndex = 82
            title.Parent = panel
            local search = Instance.new("TextBox")
            search.Name = "CommandSearch"
            search.Size = UDim2.new(1, -24, 0, 38)
            search.Position = UDim2.fromOffset(12, 42)
            search.BackgroundColor3 = COLORS.input
            search.BorderSizePixel = 0
            search.PlaceholderText = "Search commands..."
            search.Text = ""
            search.TextColor3 = COLORS.text
            search.PlaceholderColor3 = COLORS.textMuted
            search.Font = Enum.Font.Gotham
            search.TextSize = 12
            search.ClearTextOnFocus = false
            search.ZIndex = 82
            search.Parent = panel
            local searchCorner = Instance.new("UICorner", search)
            searchCorner.CornerRadius = UDim.new(0, 7)
            local results = Instance.new("ScrollingFrame")
            results.Name = "CommandResults"
            results.Size = UDim2.new(1, -24, 1, -102)
            results.Position = UDim2.fromOffset(12, 88)
            results.BackgroundTransparency = 1
            results.BorderSizePixel = 0
            results.ScrollBarThickness = 3
            results.ScrollBarImageColor3 = COLORS.primary
            results.CanvasSize = UDim2.new()
            results.ZIndex = 82
            results.Parent = panel
            local resultLayout = Instance.new("UIListLayout", results)
            resultLayout.Padding = UDim.new(0, 5)
            resultLayout.SortOrder = Enum.SortOrder.LayoutOrder
            local resultPadding = Instance.new("UIPadding", results)
            resultPadding.PaddingBottom = UDim.new(0, 4)
            local rows = {}
            local selectedIndex = 1
            local function commandMatches(command, query)
                local haystack = string.lower(table.concat({
                    tostring(command.Name or ""),
                    tostring(command.Description or ""),
                    tostring(command.Category or ""),
                    tostring(command.Keywords or ""),
                }, " "))
                for token in string.gmatch(string.lower(query), "%S+") do
                    if not string.find(haystack, token, 1, true) then return false end
                end
                return true
            end
            local function selectRow(index)
                if #rows == 0 then selectedIndex = 0; return end
                selectedIndex = math.clamp(index, 1, #rows)
                for rowIndex, row in ipairs(rows) do
                    row.Button.BackgroundColor3 = rowIndex == selectedIndex and COLORS.surfaceHover or COLORS.surface
                    row.ButtonStroke.Color = rowIndex == selectedIndex and COLORS.primary or COLORS.glassRaised
                end
                local row = rows[selectedIndex]
                if row then
                    local y = row.Button.Position.Y.Offset
                    results.CanvasPosition = Vector2.new(0, math.max(0, y - 120))
                end
            end
            local function runCommand(command)
                if type(command.Callback) ~= "function" then return false end
                overlay.Visible = false
                search:ReleaseFocus()
                local success, err = pcall(command.Callback, self)
                if not success then ObsidianGlassEngine:Notify({ Type = "Error", Title = "Command failed", Content = tostring(err) }) end
                return success
            end
            local function refresh()
                for _, row in ipairs(rows) do row.Button:Destroy() end
                table.clear(rows)
                local query = search.Text
                for _, command in ipairs(commands) do
                    if commandMatches(command, query) then
                        local rowButton = Instance.new("TextButton")
                        rowButton.Name = "Command_" .. tostring(command.Name):gsub("[^%w_]", "_")
                        rowButton.Size = UDim2.new(1, -4, 0, 52)
                        rowButton.BackgroundColor3 = COLORS.surface
                        rowButton.BorderSizePixel = 0
                        rowButton.AutoButtonColor = false
                        rowButton.Text = ""
                        rowButton.LayoutOrder = #rows + 1
                        rowButton.ZIndex = 83
                        rowButton.Parent = results
                        local rowCorner = Instance.new("UICorner", rowButton)
                        rowCorner.CornerRadius = UDim.new(0, 7)
                        local rowStroke = Instance.new("UIStroke", rowButton)
                        rowStroke.Color = COLORS.glassRaised
                        rowStroke.Transparency = 0.25
                        local rowTitle = Instance.new("TextLabel")
                        rowTitle.Size = UDim2.new(1, -20, 0, 22)
                        rowTitle.Position = UDim2.fromOffset(10, 5)
                        rowTitle.BackgroundTransparency = 1
                        rowTitle.Text = tostring(command.Name or "Command")
                        rowTitle.TextColor3 = COLORS.text
                        rowTitle.Font = Enum.Font.GothamBold
                        rowTitle.TextSize = 11
                        rowTitle.TextXAlignment = Enum.TextXAlignment.Left
                        rowTitle.ZIndex = 84
                        rowTitle.Parent = rowButton
                        local rowDescription = Instance.new("TextLabel")
                        rowDescription.Size = UDim2.new(1, -20, 0, 16)
                        rowDescription.Position = UDim2.fromOffset(10, 27)
                        rowDescription.BackgroundTransparency = 1
                        rowDescription.Text = tostring(command.Description or command.Category or "")
                        rowDescription.TextColor3 = COLORS.textMuted
                        rowDescription.Font = Enum.Font.Gotham
                        rowDescription.TextSize = 9
                        rowDescription.TextXAlignment = Enum.TextXAlignment.Left
                        rowDescription.TextTruncate = Enum.TextTruncate.AtEnd
                        rowDescription.ZIndex = 84
                        rowDescription.Parent = rowButton
                        local row = { Command = command, Button = rowButton, ButtonStroke = rowStroke }
                        rows[#rows + 1] = row
                        rowButton.Activated:Connect(function() runCommand(command) end)
                    end
                end
                results.CanvasSize = UDim2.new(0, 0, 0, #rows * 57 + 5)
                selectRow(1)
            end
            local api = {}
            function api:Register(command)
                if type(command) ~= "table" or type(command.Callback) ~= "function" then return false end
                if not command.Name or tostring(command.Name) == "" then return false end
                commands[#commands + 1] = command
                table.sort(commands, function(a, b) return string.lower(tostring(a.Name)) < string.lower(tostring(b.Name)) end)
                refresh()
                return true
            end
            function api:Remove(name)
                for index = #commands, 1, -1 do
                    if string.lower(tostring(commands[index].Name)) == string.lower(tostring(name)) then
                        table.remove(commands, index)
                    end
                end
                refresh()
            end
            function api:Open()
                overlay.Visible = true
                search.Text = ""
                refresh()
                task.defer(function() if overlay.Visible then search:CaptureFocus() end end)
            end
            function api:Close()
                overlay.Visible = false
                search:ReleaseFocus()
            end
            function api:Toggle()
                if overlay.Visible then self:Close() else self:Open() end
            end
            function api:Destroy()
                overlay:Destroy()
                self.Destroyed = true
            end
            function api:List()
                local resultList = {}
                for _, command in ipairs(commands) do resultList[#resultList + 1] = command end
                return resultList
            end
            self.CommandPalette = api
            search:GetPropertyChangedSignal("Text"):Connect(refresh)
            outside.Activated:Connect(function() api:Close() end)
            resultLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                results.CanvasSize = UDim2.new(0, 0, 0, resultLayout.AbsoluteContentSize.Y + 8)
            end)
            table.insert(trackedConnections, UserInputService.InputBegan:Connect(function(input, processed)
                if input.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
                    api:Toggle()
                    return
                end
                if not overlay.Visible then return end
                if input.KeyCode == Enum.KeyCode.Escape then api:Close()
                elseif input.KeyCode == Enum.KeyCode.Down then selectRow(selectedIndex + 1)
                elseif input.KeyCode == Enum.KeyCode.Up then selectRow(selectedIndex - 1)
                elseif input.KeyCode == Enum.KeyCode.Return and rows[selectedIndex] then runCommand(rows[selectedIndex].Command)
                end
            end))
            for _, command in ipairs(type(commandList) == "table" and commandList or {}) do api:Register(command) end
            refresh()
            return api
        end
    end

    self.LastWindow = WindowObj
    return WindowObj
end

function ObsidianGlassEngine:Finalize(config)
    config = type(config) == "table" and config or {}
    local window = config.Window or self.LastWindow
    if not window then return nil end
    if config.AppearanceTab then window:CreateAppearanceTab(config.AppearanceTabTitle) end
    if config.NotifyReady ~= false then
        self:Notify({ Title = "PAYOMBØYZ UI", Content = "Interface ready", Duration = 2.5 })
    end
    return window
end

return ObsidianGlassEngine
