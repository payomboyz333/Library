                    local tipStroke = Instance.new("UIStroke", tooltip)
                    tipStroke.Color = COLORS.primary
                    tipStroke.Transparency = 0.15
                    local tipLabel = Instance.new("TextLabel")
                    tipLabel.Size = UDim2.new(1, -18, 0, 0)
                    tipLabel.Position = UDim2.fromOffset(9, 7)
                    tipLabel.AutomaticSize = Enum.AutomaticSize.Y
                    tipLabel.BackgroundTransparency = 1
                    tipLabel.Text = tipText
