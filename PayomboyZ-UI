-- Brand mark loader. Give Window.Logo a Roblox asset id or a raw image URL to override.
local DEFAULT_BRAND_LOGO = "https://raw.githubusercontent.com/payomboyz333/Library/refs/heads/main/LogoPayomboyZ.png"
local FALLBACK_BRAND_LOGO = "rbxassetid://10723346959"
local brandLogoCache = {}
local brandLogoLoading = {}
local brandLogoWaiters = {}

local function logoCacheFile(source)
    local hash = 5381
    for index = 1, #source do hash = (hash * 33 + string.byte(source, index)) % 4294967296 end
    return string.format("payomboyz_logo_%08x.png", hash)
end

local function loadIntroLogoImage(source, onReady)
    source = type(source) == "string" and source ~= "" and source or DEFAULT_BRAND_LOGO
    if not source:match("^https?://") then
        if source:match("^rbxassetid://") or source:match("^rbxasset://") then
            if type(onReady) == "function" then task.defer(onReady, source) end
            return source
        end
        local getAsset = getcustomasset or getsynasset
        if type(getAsset) == "function" then
            local ok, localAsset = pcall(getAsset, source)
            if ok and type(localAsset) == "string" then
                brandLogoCache[source] = localAsset
                if type(onReady) == "function" then task.defer(onReady, localAsset) end
                return localAsset
            end
        end
        return FALLBACK_BRAND_LOGO
    end
    if brandLogoCache[source] then
        if type(onReady) == "function" then task.defer(onReady, brandLogoCache[source]) end
        return brandLogoCache[source]
    end
    if type(onReady) == "function" then
        brandLogoWaiters[source] = brandLogoWaiters[source] or {}
        table.insert(brandLogoWaiters[source], onReady)
    end
    if not brandLogoLoading[source] then
        brandLogoLoading[source] = true
        task.spawn(function()
            local asset
            pcall(function()
                local getAsset = getcustomasset or getsynasset
                local fileName = logoCacheFile(source)
                if type(getAsset) ~= "function" then return end
                if type(isfile) == "function" and isfile(fileName) then
                    local ok, localAsset = pcall(getAsset, fileName)
                    if ok then asset = localAsset; return end
                end
                if type(writefile) ~= "function" then return end
                local ok, imageBytes = pcall(game.HttpGet, game, source, true)
                if ok and type(imageBytes) == "string" and #imageBytes > 128 then
                    writefile(fileName, imageBytes)
                    if type(isfile) ~= "function" or isfile(fileName) then
                        local assetOk, localAsset = pcall(getAsset, fileName)
                        if assetOk then asset = localAsset end
                    end
                end
            end)
            brandLogoLoading[source] = nil
            if asset then brandLogoCache[source] = asset end
            local waiters = brandLogoWaiters[source] or {}
            brandLogoWaiters[source] = nil
            for _, callback in ipairs(waiters) do
                if asset then pcall(callback, asset) end
            end
        end)
    end
    return FALLBACK_BRAND_LOGO
end

-- Helper: Get parent GUI
local function getSafeParentGui()
    if typeof(gethui) == "function" then
        local ok, res = pcall(gethui)
        if ok and res and typeof(res) == "Instance" then return res end
    end
    if typeof(cloneref) == "function" then
        local ok, cg = pcall(function() return cloneref(game:GetService("CoreGui")) end)
        if ok and cg then return cg end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
end

