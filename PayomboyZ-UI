            dSelected.BackgroundTransparency = 1
            dSelected.Text = tostring(defVal) .. " ▼"
            dSelected.TextColor3 = COLORS.cyan
            dSelected.Font = Enum.Font.GothamBold
            dSelected.TextSize = 12
            dSelected.TextXAlignment = Enum.TextXAlignment.Right
            dSelected.Parent = frame

            local dropBtn = Instance.new("TextButton")
            dropBtn.Size = UDim2.new(1, 0, 0, 44)
            dropBtn.BackgroundTransparency = 1
            dropBtn.Text = ""
            dropBtn.Parent = frame

            local listContainer = Instance.new("Frame")
            listContainer.Size = UDim2.new(1, -24, 0, #values * 28)
            listContainer.Position = UDim2.new(0, 12, 0, 44)
            listContainer.BackgroundTransparency = 1
            listContainer.Parent = frame

            local listLayout = Instance.new("UIListLayout")
            listLayout.FillDirection = Enum.FillDirection.Vertical
            listLayout.Padding = UDim.new(0, 2)
            listLayout.Parent = listContainer

            local opened = false
            local DropObj = { Value = defVal }

            local function toggleDrop()
                opened = not opened
                dSelected.Text = tostring(DropObj.Value) .. (opened and " ▲" or " ▼")
                local targetHeight = opened and (48 + #values * 30) or 44
                TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Size = UDim2.new(1, -10, 0, targetHeight) }):Play()
            end

            dropBtn.MouseButton1Click:Connect(function()
                playClickSound()
                toggleDrop()
            end)

            for _, val in ipairs(values) do
                local itm = Instance.new("TextButton")
                itm.Size = UDim2.new(1, 0, 0, 26)
                itm.BackgroundColor3 = COLORS.surfaceRaised
                itm.BackgroundTransparency = 0.40
                itm.Text = "  " .. tostring(val)
                itm.TextColor3 = COLORS.textMuted
                itm.Font = Enum.Font.GothamMedium
                itm.TextSize = 11
                itm.TextXAlignment = Enum.TextXAlignment.Left
                itm.Parent = listContainer

                local itmCorner = Instance.new("UICorner")
                itmCorner.CornerRadius = UDim.new(0, 5)
                itmCorner.Parent = itm

                itm.MouseButton1Click:Connect(function()
                    playClickSound()
                    DropObj.Value = val
                    dSelected.Text = tostring(val) .. " ▼"
                    toggleDrop()
                    pcall(cb, val)
                end)
            end

            function DropObj:SetValue(v)
                DropObj.Value = v
                dSelected.Text = tostring(v) .. " ▼"
                pcall(cb, v)
            end

            ObsidianGlassEngine.Options[idx] = DropObj
            return DropObj
        end

        function TabObj:AddInput(idx, iCfg)
            local title = iCfg.Title or "Input"
            local defVal = iCfg.Default or ""
            local placeholder = iCfg.Placeholder or "Type here..."
            local cb = iCfg.Callback or function() end

            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -10, 0, 46)
            frame.BackgroundColor3 = COLORS.glassDeep
            frame.BackgroundTransparency = 0.18
            frame.BorderSizePixel = 0
            frame.Parent = pageScroll

            local fCorner = Instance.new("UICorner")
            fCorner.CornerRadius = UDim.new(0, 8)
            fCorner.Parent = frame

            local fStroke = Instance.new("UIStroke")
            fStroke.Color = COLORS.glassRaised
            fStroke.Thickness = 1
            fStroke.Parent = frame

            local iTitle = Instance.new("TextLabel")
            iTitle.Size = UDim2.new(0, 140, 1, 0)
            iTitle.Position = UDim2.new(0, 12, 0, 0)
            iTitle.BackgroundTransparency = 1
            iTitle.Text = title
            iTitle.TextColor3 = COLORS.text
            iTitle.Font = Enum.Font.GothamBold
            iTitle.TextSize = 13
            iTitle.TextXAlignment = Enum.TextXAlignment.Left
            iTitle.Parent = frame

            local textBox = Instance.new("TextBox")
            textBox.Size = UDim2.new(1, -170, 0, 30)
            textBox.Position = UDim2.new(1, -158, 0.5, -15)
            textBox.BackgroundColor3 = COLORS.input
            textBox.BackgroundTransparency = 0.20
            textBox.Text = defVal
            textBox.PlaceholderText = placeholder
            textBox.PlaceholderColor3 = COLORS.textFaint
            textBox.TextColor3 = COLORS.cyan
            textBox.Font = Enum.Font.GothamMedium
            textBox.TextSize = 12
            textBox.Parent = frame

            local tbCorner = Instance.new("UICorner")
            tbCorner.CornerRadius = UDim.new(0, 6)
            tbCorner.Parent = textBox

            local tbStroke = Instance.new("UIStroke")
            tbStroke.Color = COLORS.glassRaised
            tbStroke.Thickness = 1
            tbStroke.Parent = textBox

            textBox.Focused:Connect(function()
                TweenService:Create(tbStroke, TweenInfo.new(0.2), { Color = COLORS.cyan }):Play()
            end)
            textBox.FocusLost:Connect(function()
                TweenService:Create(tbStroke, TweenInfo.new(0.2), { Color = COLORS.glassRaised }):Play()
                pcall(cb, textBox.Text)
            end)

            local InputObj = { Value = defVal }
            function InputObj:SetValue(v)
                textBox.Text = v
                InputObj.Value = v
                pcall(cb, v)
            end

            ObsidianGlassEngine.Options[idx] = InputObj
            return InputObj
        end

        function TabObj:AddParagraph(title, desc)
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -10, 0, 54)
            frame.BackgroundColor3 = COLORS.glassDeep
            frame.BackgroundTransparency = 0.18
            frame.BorderSizePixel = 0
            frame.Parent = pageScroll

            local fCorner = Instance.new("UICorner")
            fCorner.CornerRadius = UDim.new(0, 8)
            fCorner.Parent = frame

            local pTitle = Instance.new("TextLabel")
            pTitle.Size = UDim2.new(1, -20, 0, 22)
            pTitle.Position = UDim2.new(0, 10, 0, 6)
            pTitle.BackgroundTransparency = 1
            pTitle.Text = title
            pTitle.TextColor3 = COLORS.text
            pTitle.Font = Enum.Font.GothamBold
            pTitle.TextSize = 13
            pTitle.TextXAlignment = Enum.TextXAlignment.Left
            pTitle.Parent = frame

            local pDesc = Instance.new("TextLabel")
            pDesc.Size = UDim2.new(1, -20, 0, 24)
            pDesc.Position = UDim2.new(0, 10, 0, 26)
            pDesc.BackgroundTransparency = 1
            pDesc.Text = desc
            pDesc.TextColor3 = COLORS.textMuted
            pDesc.Font = Enum.Font.Gotham
            pDesc.TextSize = 11
            pDesc.TextWrapped = true
            pDesc.TextXAlignment = Enum.TextXAlignment.Left
            pDesc.Parent = frame
            return frame
        end

        table.insert(WindowObj.Tabs, TabObj)
        return TabObj
    end

    -- Keybinds: [K] Toggle Shell Visibility | [F] Toggle Scale
    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == Enum.KeyCode.K or input.KeyCode == Enum.KeyCode.RightControl then
            playClickSound()
            shell.Visible = not shell.Visible
        elseif input.KeyCode == Enum.KeyCode.F then
            playClickSound()
            uiScale.Scale = (uiScale.Scale == 1.0) and 0.85 or 1.0
        end
    end)

    return WindowObj
end

return ObsidianGlassEngine

