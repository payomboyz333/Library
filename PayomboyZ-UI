function ObsidianGlassEngine:SafeCall(callback, ...)
    if type(callback) ~= "function" then return false, "Expected a function" end
    local arguments = table.pack(...)
    return pcall(function() return callback(table.unpack(arguments, 1, arguments.n)) end)
end

function ObsidianGlassEngine:DeepCopy(value, seen)
    if type(value) ~= "table" then return value end
    seen = seen or {}
    if seen[value] then return seen[value] end
    local copy = {}
    seen[value] = copy
    for key, item in pairs(value) do
        copy[self:DeepCopy(key, seen)] = self:DeepCopy(item, seen)
    end
    return setmetatable(copy, getmetatable(value))
end

function ObsidianGlassEngine:CreateSignal()
    local event = Instance.new("BindableEvent")
    local signal = { Event = event.Event, Destroyed = false }
    function signal:Connect(callback) return event.Event:Connect(callback) end
    function signal:Once(callback)
        local connection
        connection = event.Event:Connect(function(...)
            connection:Disconnect()
            callback(...)
        end)
        return connection
    end
    function signal:Fire(...) if not self.Destroyed then event:Fire(...) end end
    function signal:Wait() return event.Event:Wait() end
    function signal:Destroy()
        if self.Destroyed then return end
        self.Destroyed = true
        event:Destroy()
    end
    return signal
end

function ObsidianGlassEngine:CreateJanitor()
    local janitor = { Tasks = {}, Destroyed = false }
    function janitor:Add(item, method, key)
        if self.Destroyed then
            if type(item) == "function" then pcall(item)
            elseif typeof(item) == "RBXScriptConnection" then pcall(function() item:Disconnect() end)
            elseif typeof(item) == "Instance" then pcall(function() item:Destroy() end)
            elseif type(item) == "thread" then pcall(task.cancel, item) end
            return item
        end
        local cleanupMethod = method
        if not cleanupMethod then
            local itemType = typeof(item)
            cleanupMethod = itemType == "RBXScriptConnection" and "Disconnect"
                or itemType == "Instance" and "Destroy"
                or type(item) == "thread" and "Cancel"
                or type(item) == "function" and true
        end
        local entry = { Item = item, Method = cleanupMethod, Key = key }
        if key then
            self:Remove(key)
            self.Tasks[key] = entry
        else
            self.Tasks[#self.Tasks + 1] = entry
        end
        return item
    end
    function janitor:Remove(key)
        local entry = self.Tasks[key]
        if not entry then return false end
        self.Tasks[key] = nil
        local item, cleanupMethod = entry.Item, entry.Method
        if cleanupMethod == true and type(item) == "function" then pcall(item)
        elseif cleanupMethod == "Cancel" and type(item) == "thread" then pcall(task.cancel, item)
        elseif type(cleanupMethod) == "string" and item and type(item[cleanupMethod]) == "function" then pcall(item[cleanupMethod], item) end
        return true
    end
    function janitor:Cleanup()
        for key, entry in pairs(self.Tasks) do
            self.Tasks[key] = nil
            local item, cleanupMethod = entry.Item, entry.Method
            if cleanupMethod == true and type(item) == "function" then pcall(item)
            elseif cleanupMethod == "Cancel" and type(item) == "thread" then pcall(task.cancel, item)
            elseif type(cleanupMethod) == "string" and item and type(item[cleanupMethod]) == "function" then pcall(item[cleanupMethod], item) end
        end
    end
    function janitor:Destroy()
        if self.Destroyed then return end
        self:Cleanup()
        self.Destroyed = true
    end
    return janitor
end

