    local function refreshParticleThemeColors()
        local profile = ACTIVE_THEME_PROFILE and ACTIVE_THEME_PROFILE.Particle
        local accent = ACTIVE_THEME_PROFILE and ACTIVE_THEME_PROFILE.Accent
        if not profile or typeof(accent) ~= "Color3" then return end
        if particleThemeAccent == accent then return false end
        particleThemeAccent = accent
        -- Keep seven distinct, fixed identities while tinting the full set toward
        -- the selected preset. No particle changes hue during its lifetime.
        for index, spectrumColor in ipairs(PARTICLE_SPECTRUM) do
            local h, s, v = spectrumColor:ToHSV()
            local themeHue, themeSaturation, themeValue = accent:ToHSV()
            local hue = (themeHue + h - 0.02) % 1
            local sat = math.clamp(math.max(s * 0.78, themeSaturation * 0.72), 0.48, 1)
            local val = math.clamp(math.max(v * 0.84, themeValue * (0.72 + (index % 3) * 0.08)), 0.54, 1)
            particleThemeColors[index] = Color3.fromHSV(hue, sat, val)
        end
        -- Preserve a bright ink highlight from the selected theme on the core.
        particleThemeColors[1] = ACTIVE_THEME_PROFILE.Bright or particleThemeColors[1]
        return true
    end
