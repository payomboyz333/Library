        do
            local tab = TabObj
            local sectionIndex = 0
            local widgetIndex = 0

            local function mapConfig(source)
                source = type(source) == "table" and source or {}
                local mapped = {}
                for key, value in pairs(source) do mapped[key] = value end
                mapped.Title = source.Name or source.Title or "Control"
                mapped.Description = source.Note or source.Description or ""
                mapped.Values = source.Options or source.Values or {}
                return mapped
            end

            local function makeHandle(native, source, initialValue)
                local callback = source.Callback
                local handle = {
                    Native = native,
                    Instance = type(native) == "table" and native.Instance or native,
                    Name = source.Name or source.Title,
                    Value = type(native) == "table" and native.Value or initialValue,
                }
                local changed = Instance.new("BindableEvent")
                changed.Name = "ControlChanged"
                changed.Parent = gui
                handle._changed = changed
                handle._suppress = false
                function handle:Get() return handle.Value end
                function handle:GetValue() return handle.Value end
                function handle:Subscribe(fn)
                    return changed.Event:Connect(fn)
                end
                function handle:Set(value, fireCallback)
                    handle._suppress = fireCallback == false
                    if type(native) == "table" and type(native.SetValue) == "function" then
                        pcall(native.SetValue, native, value)
                    elseif type(native) == "table" and type(native.Set) == "function" then
                        pcall(native.Set, native, value)
                    end
                    handle.Value = type(native) == "table" and native.Value or value
                    if fireCallback == false then
                        handle._suppress = false
                    elseif type(native) ~= "table" or type(native.SetValue) ~= "function" then
                        changed:Fire(handle.Value)
                    end
                    handle._suppress = false
                end
                handle.SetValue = handle.Set
                function handle:SetOptions(options, default, preserve)
                    if type(native) == "table" and type(native.SetOptions) == "function" then
                        native:SetOptions(options, default, preserve)
                    end
                end
                function handle:Destroy()
                    if self.Destroyed then return end
                    self.Destroyed = true
                    if self.Active == true and type(self.SetActive) == "function" then pcall(self.SetActive, self, false) end
                    if self.Value == true and type(self.Set) == "function" then pcall(self.Set, self, false) end
                    if self._dependencyConnection then pcall(function() self._dependencyConnection:Disconnect() end) end
                    if self.Tooltip and self.Tooltip.Parent then self.Tooltip:Destroy() end
                    if type(native) == "table" and type(native.Destroy) == "function" then
                        pcall(native.Destroy, native)
                    else
                        local target = self.Instance
                        if target and target.Parent then
                            if target:IsA("TextButton") and target.Parent:IsA("Frame") then target.Parent:Destroy()
                            else target:Destroy() end
                        end
                    end
                    if changed and changed.Parent then changed:Destroy() end
                end
                handle._controller = { GetValue = function() return handle.Value end }
                handle.JoinExclusiveGroup = function(_, group)
                    if type(group) ~= "table" then return end
                    group.Members = group.Members or {}
                    group.Members[#group.Members + 1] = handle
                    handle:Subscribe(function(value)
                        if value == true then
                            for _, other in ipairs(group.Members) do
                                if other ~= handle and other:Get() == true then other:Set(false, false) end
                            end
                        end
                    end)
                    if handle:Get() == true then
                        for _, other in ipairs(group.Members) do
                            if other ~= handle and other:Get() == true then other:Set(false, false) end
                        end
                    end
                end
                setmetatable(handle, {
                    __index = function(_, property)
                        if type(native) ~= "table" then return nil end
                        local member = native[property]
                        if type(member) == "function" then
                            return function(_, ...)
                                return member(native, ...)
                            end
                        end
                        return member
                    end,
                })
                return handle, changed, callback
            end

            local function addControl(source, kind, containerOverride)
                source = type(source) == "table" and source or {}
                widgetIndex += 1
                local previousContainer = activeControlContainer
                activeControlContainer = containerOverride
                local mapped = mapConfig(source)
                local callback = source.Callback
                local handle
                mapped.Callback = function(value, ...)
                    if handle then
                        handle.Value = value
                        if not handle._suppress and handle._changed then handle._changed:Fire(value, ...) end
                    end
                    if callback and not (handle and handle._suppress) then pcall(callback, value, ...) end
                end
                local optionId = tostring(tab.TitleLabel.Text) .. "/" .. tostring(source.Name or kind) .. "/" .. tostring(widgetIndex)
                local native
                if kind == "Toggle" then
                    native = tab:AddToggle(optionId, mapped)
                elseif kind == "Slider" then
                    native = tab:AddSlider(optionId, mapped)
                elseif kind == "Dropdown" then
                    native = tab:AddDropdown(optionId, mapped)
                elseif kind == "MultiDropdown" then
                    native = tab:AddMultiDropdown(optionId, mapped)
                elseif kind == "Input" then
                    native = tab:AddInput(optionId, mapped)
                elseif kind == "Keybind" then
                    native = tab:AddKeybind(optionId, mapped)
                elseif kind == "ColorPicker" then
                    native = tab:AddColorPicker(optionId, mapped)
                elseif kind == "RadioGroup" then
                    native = tab:AddRadioGroup(optionId, mapped)
                elseif kind == "ProgressBar" then
                    native = tab:AddProgressBar(optionId, mapped)
                elseif kind == "StatCard" then
                    native = tab:AddStatCard(optionId, mapped)
                elseif kind == "BarChart" then
                    native = tab:AddBarChart(optionId, mapped)
                elseif kind == "Callout" then
                    native = tab:AddCallout(source.Name or source.Title or "Notice", source.Text or source.Message or "", source.Kind)
                elseif kind == "Button" then
                    native = tab:AddButton(mapped)
