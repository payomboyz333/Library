            local expanded = true
            local refreshPending = false
            local function refreshSectionSize()
                if not expanded or refreshPending then return end
                refreshPending = true
                task.defer(function()
                    refreshPending = false
                    if sec.Parent and expanded then
                        local contentHeight = bodyLayout.AbsoluteContentSize.Y + 10
                        body.Size = UDim2.new(1, -20, 0, contentHeight)
                        sec.Size = UDim2.new(1, 0, 0, headerHeight + contentHeight)
                        updateColumnLayout()
                    end
                end)
            end
            bodyLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                refreshSectionSize()
            end)
            body.ChildAdded:Connect(refreshSectionSize)
            body.ChildRemoved:Connect(refreshSectionSize)
            refreshSectionSize()
            local function setExpanded(value)
                expanded = value == true
                body.Visible = expanded
                caret.Text = expanded and "v" or ">"
