        function WindowObj:FindControl(query)
            if query == nil then return nil end
            local search = tostring(query)
            if self.Options[search] then return self.Options[search] end
            local lowerSearch = string.lower(search)
            for _, control in ipairs(self:GetControls()) do
                if string.lower(tostring(control.Name or "")) == lowerSearch
                    or string.lower(tostring(control.Key or "")) == lowerSearch then
                    return control
                end
            end
            return nil
        end
        function WindowObj:Search(query)
            local needle = string.lower(tostring(query or "")):gsub("^%s+", ""):gsub("%s+$", "")
            local visibleCount = 0
            for _, control in ipairs(self:GetControls()) do
                local instance = control.Instance
                if instance and instance.Parent then
                    local text = tostring(control.Name or "")
                    for _, descendant in ipairs(instance:GetDescendants()) do
                        if descendant:IsA("TextLabel") or descendant:IsA("TextButton") then
                            text ..= " " .. descendant.Text
                        end
                    end
                    local match = needle == "" or string.find(string.lower(text), needle, 1, true) ~= nil
                    instance.Visible = match
                    if match then visibleCount += 1 end
                end
            end
            return visibleCount
        end

        local function packConfigValue(value)
            local valueType = typeof(value)
            if valueType == "Color3" then return { __PBZType = "Color3", Value = value:ToHex() } end
            if valueType == "EnumItem" then
                return { __PBZType = "EnumItem", EnumType = value.EnumType.Name, Value = value.Name }
            end
            if type(value) == "table" then
                local packed = {}
                for key, item in pairs(value) do packed[key] = packConfigValue(item) end
                return packed
            end
            if type(value) == "string" or type(value) == "number" or type(value) == "boolean" or value == nil then
                return value
            end
            return nil
        end
        local function unpackConfigValue(value)
            if type(value) ~= "table" then return value end
            if value.__PBZType == "Color3" and type(value.Value) == "string" then
                local ok, color = pcall(Color3.fromHex, value.Value)
                if ok then return color end
                return nil
            end
            if value.__PBZType == "EnumItem" and Enum[value.EnumType] then
                return Enum[value.EnumType][value.Value]
            end
            local unpacked = {}
            for key, item in pairs(value) do unpacked[key] = unpackConfigValue(item) end
            return unpacked
        end
        function WindowObj:ExportConfig()
            local controls = {}
            for _, control in ipairs(self:GetControls()) do
                if control.Key and control.Value ~= nil then
                    controls[control.Key] = packConfigValue(control.Value)
                end
            end
            return {
                Version = 1,
                Theme = self:GetTheme(),
                Motion = motionMode,
                Controls = controls,
            }
        end
        function WindowObj:ApplyConfig(config)
            if type(config) ~= "table" then return false, "Config must be a table" end
            if type(config.Theme) == "string" then self:SetTheme(config.Theme) end
            if config.Motion then self:SetMotion(config.Motion) end
            local applied = 0
            for key, storedValue in pairs(type(config.Controls) == "table" and config.Controls or {}) do
                local control = self:FindControl(key)
                local value = unpackConfigValue(storedValue)
                if control and value ~= nil and type(control.Set) == "function" then
                    control:Set(value, false)
                    applied += 1
                end
            end
            return true, applied
        end
        function WindowObj:CreateConfigManager()
            local window = self
            local profiles = {}
            local manager = { Profiles = profiles }
            function manager:Save(name)
                name = tostring(name or "")
                if name == "" then return false, "Profile name is required" end
                profiles[name] = window:ExportConfig()
                return true
            end
            function manager:Load(name)
                local config = profiles[tostring(name or "")]
                if not config then return false, "Profile not found" end
                return window:ApplyConfig(config)
            end
            function manager:Delete(name)
                name = tostring(name or "")
                if not profiles[name] then return false end
                profiles[name] = nil
                return true
            end
            function manager:List()
                local names = {}
                for name in pairs(profiles) do names[#names + 1] = name end
                table.sort(names)
                return names
            end
            function manager:Encode(name)
                local config = name and profiles[tostring(name)] or window:ExportConfig()
                if not config then return nil, "Profile not found" end
                local ok, encoded = pcall(function() return HttpService:JSONEncode(config) end)
                if not ok then return nil, tostring(encoded) end
                return encoded
            end
            function manager:Import(encoded, profileName, applyNow)
                local ok, config = pcall(function() return HttpService:JSONDecode(encoded) end)
                if not ok or type(config) ~= "table" then return false, "Invalid config JSON" end
                if profileName then profiles[tostring(profileName)] = config end
                if applyNow == true then return window:ApplyConfig(config) end
                return true
            end
            return manager
        end

