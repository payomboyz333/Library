                ObsidianGlassEngine.Options[optionId] = handle
                table.insert(controlRegistry, handle)
                if type(source.Placeholder) == "string" and handle.Instance then
                    local box = handle.Instance:FindFirstChildWhichIsA("TextBox", true)
                    if box then box.PlaceholderText = source.Placeholder end
                end
                local tipText = source.Tooltip or source.Note or source.Description
                if type(tipText) == "string" and tipText ~= "" and handle.Instance and handle.Instance:IsA("GuiObject") then
                    local tooltip = Instance.new("Frame")
                    tooltip.Name = "ControlTooltip"
                    tooltip.Size = UDim2.fromOffset(250, 0)
                    tooltip.AutomaticSize = Enum.AutomaticSize.Y
                    tooltip.BackgroundColor3 = COLORS.glass
                    tooltip.BorderSizePixel = 0
                    tooltip.Visible = false
                    tooltip.ZIndex = 120
