            titleLabel.TextSize = 11
            titleLabel.TextXAlignment = Enum.TextXAlignment.Left
            titleLabel.Parent = frame
            local chartArea = Instance.new("Frame")
            chartArea.Name = "Plot"
            chartArea.Size = UDim2.new(1, -24, 0, 98)
            chartArea.Position = UDim2.fromOffset(12, 31)
            chartArea.BackgroundTransparency = 1
            chartArea.ClipsDescendants = true
            chartArea.Parent = frame
            local gridLines = {}
            for index = 1, 3 do
                local line = Instance.new("Frame")
                line.Size = UDim2.new(1, 0, 0, 1)
                line.Position = UDim2.new(0, 0, index / 4, 0)
                line.BackgroundColor3 = COLORS.divider
                line.BackgroundTransparency = 0.35
                line.BorderSizePixel = 0
                line.ZIndex = 1
                line.Parent = chartArea
                gridLines[#gridLines + 1] = line
            end
            local bars = {}
            local data = {}
            local valueLabel = Instance.new("TextLabel")
            valueLabel.Size = UDim2.new(1, -24, 0, 14)
            valueLabel.Position = UDim2.new(0, 12, 1, -18)
            valueLabel.BackgroundTransparency = 1
            valueLabel.TextColor3 = COLORS.textMuted
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextSize = 9
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.Parent = frame
            local object = { Value = data, Instance = frame, TitleLabel = titleLabel }
            local function render()
                for _, bar in ipairs(bars) do bar:Destroy() end
                table.clear(bars)
                local maximum = 0
                for _, point in ipairs(data) do maximum = math.max(maximum, tonumber(point) or 0) end
                maximum = maximum > 0 and maximum or 1
                local count = #data
                for index, point in ipairs(data) do
                    local amount = math.max(tonumber(point) or 0, 0)
                    local ratio = amount / maximum
                    local bar = Instance.new("Frame")
                    bar.Name = "Bar_" .. tostring(index)
                    bar.AnchorPoint = Vector2.new(0, 1)
                    bar.Position = UDim2.new((index - 1) / count + 0.12 / count, 0, 0.96, 0)
                    bar.Size = UDim2.new(0.76 / count, 0, math.max(0.035, ratio * 0.86), 0)
                    bar.BackgroundColor3 = accent
                    bar.BorderSizePixel = 0
                    bar.ZIndex = 2
                    bar.Parent = chartArea
                    local barCorner = Instance.new("UICorner", bar)
                    barCorner.CornerRadius = UDim.new(0, 4)
                    local pointTip = Instance.new("TextLabel")
                    pointTip.Name = "Value"
                    pointTip.Size = UDim2.fromScale(1, 1)
                    pointTip.BackgroundTransparency = 1
                    pointTip.Text = tostring(point)
                    pointTip.TextColor3 = COLORS.text
                    pointTip.Font = Enum.Font.GothamBold
                    pointTip.TextSize = 8
                    pointTip.TextTransparency = 1
                    pointTip.Parent = bar
                    bar.MouseEnter:Connect(function() pointTip.TextTransparency = 0 end)
                    bar.MouseLeave:Connect(function() pointTip.TextTransparency = 1 end)
                    bars[#bars + 1] = bar
                end
                valueLabel.Text = count > 0 and (tostring(data[#data]) .. " latest  /  " .. tostring(maximum) .. " peak") or "No data"
                object.Value = data
            end
            function object:SetData(nextData)
                data = {}
                if type(nextData) == "table" then
                    local first = math.max(1, #nextData - maximumPoints + 1)
                    for index = first, #nextData do
                        local number = tonumber(nextData[index])
                        if number then data[#data + 1] = number end
                    end
                end
                render()
            end
            function object:SetValue(nextData) object:SetData(nextData) end
            function object:Push(point)
                local number = tonumber(point)
                if not number then return false end
                data[#data + 1] = number
                while #data > maximumPoints do table.remove(data, 1) end
                render()
                return true
            end
            function object:SetColor(color)
                if typeof(color) ~= "Color3" then return false end
                accent = color
                stroke.Color = color
                render()
                return true
            end
            function object:Get() return data end
            function object:GetValue() return data end
            object:SetData(cCfg.Values or cCfg.Data or {})
            ObsidianGlassEngine.Options[idx] = object
            return object
        end

