            fillCorner.Parent = fill

            local sliderBtn = Instance.new("TextButton")
            sliderBtn.Size = UDim2.new(1, 0, 0, 20)
            sliderBtn.Position = UDim2.new(0, 0, 0.5, -10)
            sliderBtn.BackgroundTransparency = 1
            sliderBtn.Text = ""
            sliderBtn.ZIndex = 2
            sliderBtn.Parent = barBg

            local sliderHalo = Instance.new("Frame")
            sliderHalo.Name = "SliderEnergyHalo"
            sliderHalo.AnchorPoint = Vector2.new(0.5, 0.5)
            sliderHalo.Size = UDim2.fromOffset(22, 22)
            sliderHalo.Position = UDim2.new(initPct, 0, 0.5, 0)
            sliderHalo.BackgroundTransparency = 1
            sliderHalo.ZIndex = 2
            sliderHalo.Parent = barBg
            local sliderHaloCorner = Instance.new("UICorner")
            sliderHaloCorner.CornerRadius = UDim.new(1, 0)
            sliderHaloCorner.Parent = sliderHalo
            local sliderHaloStroke = Instance.new("UIStroke")
            sliderHaloStroke.Color = COLORS.primary
            sliderHaloStroke.Thickness = 1
            sliderHaloStroke.Transparency = 1
            sliderHaloStroke.Parent = sliderHalo

            local sliderThumb = Instance.new("Frame")
            sliderThumb.Name = "SliderBladeHandle"
            sliderThumb.AnchorPoint = Vector2.new(0.5, 0.5)
            sliderThumb.Size = UDim2.fromOffset(14, 14)
            sliderThumb.Position = UDim2.new(initPct, 0, 0.5, 0)
            sliderThumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            sliderThumb.BorderSizePixel = 0
            sliderThumb.ZIndex = 3
            sliderThumb.Parent = barBg
            local sliderThumbCorner = Instance.new("UICorner")
            sliderThumbCorner.CornerRadius = UDim.new(1, 0)
            sliderThumbCorner.Parent = sliderThumb
            local sliderThumbStroke = Instance.new("UIStroke")
            sliderThumbStroke.Color = COLORS.primary
            sliderThumbStroke.Thickness = 2
            sliderThumbStroke.Parent = sliderThumb
            local sliderCore = Instance.new("Frame")
            sliderCore.AnchorPoint = Vector2.new(0.5, 0.5)
            sliderCore.Position = UDim2.fromScale(0.5, 0.5)
            sliderCore.Size = UDim2.fromOffset(4, 4)
            sliderCore.BackgroundColor3 = COLORS.primary
            sliderCore.BorderSizePixel = 0
            sliderCore.ZIndex = 4
            sliderCore.Parent = sliderThumb
            local sliderCoreCorner = Instance.new("UICorner")
            sliderCoreCorner.CornerRadius = UDim.new(1, 0)
            sliderCoreCorner.Parent = sliderCore

            local currentVal = defVal
            local SliderObj = { Value = currentVal, Instance = frame }

            local function updateSlider(inputX)
                local absPos = barBg.AbsolutePosition.X
                local absSize = barBg.AbsoluteSize.X
                local pct = math.clamp((inputX - absPos) / absSize, 0, 1)
                local rawVal = minVal + (maxVal - minVal) * pct
                local formattedVal = (rounding == 0) and math.floor(rawVal) or tonumber(string.format("%." .. rounding .. "f", rawVal))
                fill.Size = UDim2.new(pct, 0, 1, 0)
                sliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
                sliderHalo.Position = UDim2.new(pct, 0, 0.5, 0)
                sVal.Text = tostring(formattedVal)
                SliderObj.Value = formattedVal
                pcall(cb, formattedVal)
            end

            local sliding = false
            sliderBtn.InputBegan:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    sliderHaloStroke.Transparency = 0.32
                    updateSlider(inp.Position.X)
                    inp.Changed:Connect(function()
                        if inp.UserInputState == Enum.UserInputState.End then
                            sliding = false
                            sliderHaloStroke.Transparency = 1
                        end
                    end)
                end
            end)

            local inputConnection = UserInputService.InputChanged:Connect(function(inp)
                if sliding and (inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(inp.Position.X)
                end
            end)
            table.insert(trackedConnections, inputConnection)
            SliderObj._InputConnection = inputConnection

            function SliderObj:Destroy()
                sliding = false
                if inputConnection then inputConnection:Disconnect(); inputConnection = nil end
                if frame.Parent then frame:Destroy() end
            end

            function SliderObj:SetValue(v)
                v = math.clamp(v, minVal, maxVal)
                local pct = (v - minVal) / (maxVal - minVal)
                fill.Size = UDim2.new(pct, 0, 1, 0)
                sliderThumb.Position = UDim2.new(pct, 0, 0.5, 0)
                sliderHalo.Position = UDim2.new(pct, 0, 0.5, 0)
                sVal.Text = tostring(v)
                SliderObj.Value = v
                pcall(cb, v)
            end

            ObsidianGlassEngine.Options[idx] = SliderObj
            return SliderObj
        end

        function TabObj:AddButton(bCfg)
            local title = bCfg.Title or "Button"
            local cb = bCfg.Callback or function() end
            local confirmText = bCfg.Confirm
            local confirmWindow = tonumber(bCfg.ConfirmWindow) or 3
            local waitingForConfirm = false
            local originalText = resolveIcon(bCfg.Icon or "spark") .. "  " .. title

            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -10, 0, 38)
            frame.BackgroundColor3 = COLORS.surfaceRaised
            frame.BorderSizePixel = 0
            frame.Parent = getControlContainer()

            local fCorner = Instance.new("UICorner")
            fCorner.CornerRadius = UDim.new(0, 8)
            fCorner.Parent = frame

            local fStroke = Instance.new("UIStroke")
            fStroke.Color = COLORS.primary
            fStroke.Thickness = 1.2
            fStroke.Transparency = 0.4
            fStroke.Parent = frame
            addAnimeEdge(frame)

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.fromScale(1, 1)
            btn.BackgroundTransparency = 1
            btn.Text = originalText
            btn.TextColor3 = COLORS.text
            btn.Font = Enum.Font.GothamBold
            btn.TextSize = 14
            btn.Parent = frame
            sharpenText(btn, 0.40)
            local buttonHovered = false

            btn.MouseEnter:Connect(function()
                buttonHovered = true
                animate(frame, TweenInfo.new(0.2), { BackgroundColor3 = COLORS.surfaceHover })
                animate(fStroke, TweenInfo.new(0.2), { Transparency = 0 })
            end)

            btn.MouseLeave:Connect(function()
                buttonHovered = false
                animate(frame, TweenInfo.new(0.2), { BackgroundColor3 = COLORS.surfaceRaised })
                animate(fStroke, TweenInfo.new(0.2), { Transparency = 0.4 })
            end)

            btn.Activated:Connect(function()
                playClickSound()
                animate(frame, TweenInfo.new(0.10, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = COLORS.primaryPressed,
                })
                animate(fStroke, TweenInfo.new(0.10), { Color = COLORS.primaryHover, Thickness = 2.2, Transparency = 0 })
                task.delay(0.14, function()
                    if frame.Parent then
                        animate(frame, TweenInfo.new(0.18), { BackgroundColor3 = buttonHovered and COLORS.surfaceHover or COLORS.surfaceRaised })
                        animate(fStroke, TweenInfo.new(0.18), {
                            Color = waitingForConfirm and COLORS.warning or COLORS.primary,
                            Thickness = 1.2,
                            Transparency = buttonHovered and 0 or 0.4,
                        })
                    end
                end)
                if confirmText and not waitingForConfirm then
                    waitingForConfirm = true
                    btn.Text = "✓ " .. (type(confirmText) == "string" and confirmText or ("Confirm " .. title))
                    fStroke.Color = COLORS.warning
                    task.delay(confirmWindow, function()
                        if btn.Parent and waitingForConfirm then
                            waitingForConfirm = false
                            btn.Text = originalText
                            fStroke.Color = COLORS.primary
                        end
                    end)
                    return
                end
                waitingForConfirm = false
                btn.Text = originalText
                fStroke.Color = COLORS.primary
                pcall(cb)
            end)
            return btn
        end

