function Window:_navButton(order, iconValue, label, onClick)
	local T = self.Theme
	local btn = button(T, {
		Name = label,
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		Parent = self.Nav,
	}, {
		corner(8),
		new("UIGradient", { Color = ColorSequence.new(T.Accent, T.AccentDark) }),
	})
	local st = stroke(T.Accent, 1, 1)
	st.Parent = btn
	local ic = icon(T, iconValue, 20, T.SubText, {
		Parent = btn,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
	})
	local lb = text(T, {
		Parent = btn,
		Position = UDim2.fromOffset(44, 0),
		Size = UDim2.new(1, -52, 1, 0),
		Text = label,
		TextSize = 14,
		TextColor3 = T.SubText,
	})

	local api = { Button = btn, Selected = false }
	function api.SetSelected(on)
		api.Selected = on
		tween(btn, { BackgroundTransparency = on and 0.05 or 1 })
		tween(st, { Transparency = on and 0.3 or 1 })
		tween(lb, { TextColor3 = on and T.Text or T.SubText })
		setIconColor(ic, on and T.Text or T.SubText)
	end
	btn.MouseEnter:Connect(function()
		if not api.Selected then
			tween(btn, { BackgroundTransparency = 0.88 }, 0.12)
		end
	end)
	btn.MouseLeave:Connect(function()
		if not api.Selected then
			tween(btn, { BackgroundTransparency = 1 }, 0.12)
		end
	end)
	btn.MouseButton1Click:Connect(onClick)
	return api
end

function Window:AddTab(opts)
	opts = opts or {}
