-- ── KEY state ──

-- ok: boolean · info: {Status, Scope, Expires, DaysLeft} when ok, or an error string when not
function Window:SetKeyState(ok, info)
	self.Verified = ok == true
	self.KeyState = {
		Verified = ok == true,
		Info = type(info) == "table" and info or nil,
		Message = type(info) == "string" and info or nil,
	}
	for _, apply in ipairs(self.KeyViews) do
		apply(self.KeyState)
	end
	self.KeyChanged:Fire(self.Verified, info)
end

-- ── games ──

function Window:AddGame(data)
	local g = {}
	for k, v in pairs(data or {}) do
		g[k] = v
	end
	g.Name = g.Name or "Game"
	g.Tags = g.Tags or {}
	g.Status = g.Status or "Online"
	g.RequireKey = g.RequireKey ~= false
	g.Favorite = g.Favorite == true
	g.Image = toAsset(g.Image)
	g.FavChanged = Instance.new("BindableEvent")
	table.insert(self.Games, g)
	self:_queueRefresh()
	return g
end

function Window:AddGames(list_)
	for _, data in ipairs(list_) do
		self:AddGame(data)
	end
end

function Window:_queueRefresh()
	if self._refreshQueued then
		return
	end
	self._refreshQueued = true
	task.defer(function()
		self._refreshQueued = false
		if self.Destroyed then
			return
		end
		for _, gr in ipairs(self.Grids) do
			gr:Refresh()
		end
	end)
end

function Window:_refreshDynamic()
	for _, gr in ipairs(self.Grids) do
		if gr.Dynamic then
			gr:Refresh()
		end
	end
end

function Window:_toggleFavorite(g)
	g.Favorite = not g.Favorite
	g.FavChanged:Fire()
	self:_refreshDynamic()
end

function Window:_openGame(g)
	if g.Status == "Offline" then
		self:Notify({ Title = g.Name, Text = S.GameOffline, Type = "Error" })
		return
	end
	if g.RequireKey and self.RequireKey and not self.Verified then
		self:Notify({ Title = "KEY", Text = S.KeyNeeded, Type = "Warning" })
		return
	end
	self._openCounter = self._openCounter + 1
	g.LastOpened = self._openCounter
	self:_refreshDynamic()
	if g.Callback then
		task.spawn(function()
			local ok, err = pcall(g.Callback, g)
			if not ok then
				self:Notify({ Title = S.Error, Text = tostring(err), Type = "Error" })
			end
		end)
	end
end

