            end
        end
    })
    GameTab:AddDropdown({
        Name = "เลือกโหมดการต่อสู้",
        Options = { "ตีประชิด (Melee)", "โจมตีระยะไกล (Ranged)", "รวดเร็ว (Fast Attack)" },
        Default = "ตีประชิด (Melee)",
        Callback = function(selected)
            print("[PayomboyZ] Selected Combat Mode:", selected)
        end
    })
    GameTab:AddButton({
        Name = "รีเซ็ตตัวละคร (Reset Character)",
