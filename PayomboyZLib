        Callback = function()
            Library:Notify({ Title = "Remote Spy", Content = "กำลังเปิด Remote Spy...", Type = "info" })
        end
    })

    -- Populate "ตั้งค่า" (Settings Tab)
    SettingsTab:AddSection("การตั้งค่า UI & ระบบ")
