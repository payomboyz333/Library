	local function apply(state)
		local info = state.Info or {}
		if state.Verified then
			badgeText.Text = S.KeyOk
			badgeText.TextColor3 = T.Success
			badge.BackgroundColor3 = T.SuccessDark
			badgeStroke.Color = T.Success
			rStatus(S.Status, info.Status or S.Verified)
			rExpire(S.Expires, info.Expires or "-")
			rScope(S.Scope, info.Scope or S.AllMaps)
		else
			badgeText.Text = S.KeyNotOk
			badgeText.TextColor3 = T.SubText
			badge.BackgroundColor3 = T.Card2
			badgeStroke.Color = T.Stroke
			rStatus(S.Status, "-")
			rExpire(S.Expires, "-")
			rScope(S.Scope, "-")
		end
	end
	table.insert(self.KeyViews, apply)
	apply(self.KeyState)
	return p
end

