-- opts: {Name, Default = Enum.KeyCode, Callback(), Changed(keyCode)}
function Section:AddKeybind(opts)
	local win, T = self.Window, self.Theme
	opts = opts or {}
	local key = opts.Default
	local listening = false
	local row = self:_row(44)
	rowTitle(T, row, opts.Name or "Keybind", nil, 130)
	local b = button(T, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(90, 30),
		BackgroundColor3 = T.Background,
		Font = T.Font,
		TextSize = 12,
		Parent = row,
	}, { corner(6), stroke(T.Stroke, 1) })
	local function paint()
		b.Text = listening and "..." or (key and key.Name or "None")
	end
	paint()
	b.MouseButton1Click:Connect(function()
		listening = true
		paint()
	end)
	win:_connect(UserInputService.InputBegan, function(input, processed)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode ~= Enum.KeyCode.Escape then
					key = input.KeyCode
					if opts.Changed then
						task.spawn(opts.Changed, key)
					end
				end
				paint()
			end
		elseif not processed and key and input.KeyCode == key and opts.Callback then
			task.spawn(opts.Callback)
		end
	end)
	return {
		Get = function()
			return key
		end,
		Set = function(k)
			key = k
			paint()
		end,
	}
end

