		Size = UDim2.fromOffset(236, 104),
		BackgroundColor3 = T.Background,
		BorderSizePixel = 0,
		Parent = panel,
	}, { corner(8) })
	local resStroke = stroke(T.Stroke, 1)
	resStroke.Parent = result
	local resBadge = new("Frame", {
		Position = UDim2.fromOffset(10, 8),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = T.Stroke,
		BorderSizePixel = 0,
		Parent = result,
	}, { corner(15) })
	local resGlyph = icon(T, Library.Icons.Check, 16, Color3.new(1, 1, 1), {
		Parent = resBadge,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
	})
	local resTitle = text(T, {
		Parent = result,
		Position = UDim2.fromOffset(48, 8),
		Size = UDim2.new(1, -56, 0, 30),
		Font = T.FontBold,
		TextSize = 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local lines = {}
	for i = 1, 3 do
		lines[i] = text(T, {
			Parent = result,
			Position = UDim2.fromOffset(12, 38 + (i - 1) * 20),
			Size = UDim2.new(1, -20, 0, 20),
			TextSize = 12,
			RichText = true,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end

	local function setGlyph(value)
		-- only text glyphs can change; an image icon stays as it is
		if resGlyph:IsA("TextLabel") then
			resGlyph.Text = value
		end
	end

	local function apply(state)
		local info = state.Info or {}
		if state.Verified then
			resTitle.Text = S.KeyValid
			resTitle.TextColor3 = T.Success
			resBadge.BackgroundColor3 = T.Success
			setGlyph(Library.Icons.Check)
			resStroke.Color = T.Success
			local days = info.DaysLeft and ("  (" .. string.format(S.DaysLeft, info.DaysLeft) .. ")") or ""
			local ticks = '<font color="' .. hex(T.Success) .. '">' .. esc(Library.Icons.Check) .. "</font> "
			lines[1].Text = ticks .. esc(S.Status .. " : " .. (info.Status or S.Verified))
			lines[2].Text = ticks .. esc(info.Scope or S.AllMapsLong)
			lines[3].Text = ticks .. esc(S.Expires .. " : " .. (info.Expires or "-") .. days)
		elseif state.Message then
			resTitle.Text = S.KeyInvalid
			resTitle.TextColor3 = T.Danger
			resBadge.BackgroundColor3 = T.Danger
			setGlyph("!")
			resStroke.Color = T.StrokeAccent
			lines[1].Text = esc(state.Message)
			lines[2].Text = ""
			lines[3].Text = ""
		else
			resTitle.Text = S.KeyNone
			resTitle.TextColor3 = T.SubText
			resBadge.BackgroundColor3 = T.Stroke
			setGlyph("?")
			resStroke.Color = T.Stroke
			lines[1].Text = ""
			lines[2].Text = ""
			lines[3].Text = ""
		end
	end
	table.insert(win.KeyViews, apply)
	apply(win.KeyState)

	local busy = false
	local function submit()
		if busy then
			return
		end
		local key = keyBox.Text
		if key == "" then
			win:Notify({ Title = "KEY", Text = S.KeyEmpty, Type = "Warning" })
			return
		end
		if not opts.OnVerify then
			win:Notify({ Title = "KEY", Text = S.KeyNoHandler, Type = "Warning" })
			return
		end
		busy = true
		verifyBtn.Text = S.KeyChecking
		task.spawn(function()
			local success, valid, info = pcall(opts.OnVerify, key)
			busy = false
			verifyBtn.Text = opts.ButtonText or S.KeyButton
			if win.Destroyed then
				return
			end
			if not success then
				win:SetKeyState(false, S.KeyFailed)
				return
			end
			win:SetKeyState(valid == true, info)
			if valid == true then
				win:Notify({ Title = "KEY", Text = S.KeyValid, Type = "Success" })
			end
		end)
	end
	verifyBtn.MouseButton1Click:Connect(submit)
	keyBox.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)

	return { Frame = panel, Box = keyBox, Submit = submit }
end

