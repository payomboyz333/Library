    -- Tab Switching Logic
    function Library:SelectTab(tabName)
        Library.CurrentTab = tabName

        if tabName == "หน้าหลัก" then
            SidebarIndicator.Visible = false
            CustomPageContainer.Visible = false
            for _, tabData in pairs(Library.Tabs) do
                if tabData.PageFrame then
                    tabData.PageFrame.Visible = false
                end
            end
        else
            -- Move Sidebar Indicator
            local tabInfo = tabPositions[tabName]
            if tabInfo then
                SidebarIndicator.Visible = true
                Tween(SidebarIndicator, {
                    Position = tabInfo.Pos,
                    Size = tabInfo.Size
                }, 0.2)
                SubHeaderTitle.Text = tabName
                SubHeaderSubtitle.Text = tabInfo.Subtitle or ""
            end

            CustomPageContainer.Visible = true
            for name, tabData in pairs(Library.Tabs) do
                if name == tabName then
                    if tabData.PageFrame then
                        tabData.PageFrame.Visible = true
                    end
                else
                    if tabData.PageFrame then
                        tabData.PageFrame.Visible = false
                    end
                end
            end
        end
    end

