	local tab = setmetatable({
		Window = self,
		Name = opts.Name or "Tab",
		SidePanel = opts.SidePanel == true,
		_order = 0,
	}, Tab)

	tab.Nav = self:_navButton(#self.Tabs + 1, opts.Icon or "•", tab.Name, function()
		self:SelectTab(tab)
	end)
	tab.Page = new("ScrollingFrame", {
		Name = tab.Name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Accent,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		Parent = self.Content,
	}, { pad(12, 12, 12, 12), list(12) })

	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then
		self:SelectTab(tab)
	end
	return tab
end

function Window:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		local on = t == tab
		t.Page.Visible = on
		t.Nav.SetSelected(on)
	end
	self.CurrentTab = tab
	self:_refreshLayout()
end

function Window:_refreshLayout()
	local d = self.Dim
	local show = self.CurrentTab ~= nil and self.CurrentTab.SidePanel and self.SideItems > 0
	self.Right.Visible = show
	tween(self.Content, { Size = UDim2.fromOffset(d.W - d.SIDE - (show and d.RIGHT or 0), d.BODY) }, 0.2)
end

