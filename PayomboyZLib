function Window:Destroy()
	if self.Destroyed then
		return
	end
	self.Destroyed = true
	for _, c in ipairs(self.Connections) do
		c:Disconnect()
	end
	for _, g in ipairs(self.Games) do
		g.FavChanged:Destroy()
	end
	self.KeyChanged:Destroy()
	self.Gui:Destroy()
end

