            Library:Notify({ Title = "สคริปต์", Content = "โหลด Infinite Yield แล้ว", Type = "success" })
        end
    })
    ScriptTab:AddButton({
        Name = "Dex Explorer V4",
        Description = "เปิดดูโครงสร้าง Instances ภายในเกม",
        Callback = function()
            Library:Notify({ Title = "Dex Explorer", Content = "กำลังเปิด Dex Explorer...", Type = "info" })
        end
    })
    ScriptTab:AddButton({
