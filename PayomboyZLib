		})
	end

	local offline = g.Status == "Offline"
	local open = button(T, {
		Position = UDim2.fromOffset(106, 88),
		Size = UDim2.new(1, -116, 0, 26),
		BackgroundColor3 = offline and T.Stroke or T.Accent,
		Text = Library.Icons.Play .. "  " .. (g.ButtonText or S.OpenScript),
		TextSize = 12,
		TextColor3 = offline and T.SubText or T.Text,
		Parent = card,
	}, { corner(6) })
	if not offline then
		open.MouseEnter:Connect(function()
			tween(open, { BackgroundColor3 = T.AccentHover }, 0.12)
		end)
		open.MouseLeave:Connect(function()
			tween(open, { BackgroundColor3 = T.Accent }, 0.12)
		end)
	end
	open.MouseButton1Click:Connect(function()
		win:_openGame(g)
	end)

	return card, favConn
end

function Grid:Refresh()
	for _, c in ipairs(self.Cards) do
		c.Conn:Disconnect()
		c.Frame:Destroy()
	end
	self.Cards = {}

	local shown = {}
	for _, g in ipairs(self.Window.Games) do
		if not self.Filter or self.Filter(g) then
			table.insert(shown, g)
		end
	end
	if self.Sort then
		table.sort(shown, self.Sort)
	end
	for i, g in ipairs(shown) do
		local frame, conn = buildCard(self.Window, self.Holder, g, i)
		table.insert(self.Cards, { Frame = frame, Game = g, Conn = conn })
	end
	self:ApplySearch()
end

function Grid:ApplySearch()
	local q = string.lower(self.Window.SearchText or "")
	local visible = 0
	for _, c in ipairs(self.Cards) do
		local ok = q == ""
		if not ok then
			local hay = string.lower(c.Game.Name .. " " .. table.concat(c.Game.Tags, " "))
			ok = string.find(hay, q, 1, true) ~= nil
		end
		c.Frame.Visible = ok
		if ok then
			visible = visible + 1
		end
	end
	self.Empty.Visible = visible == 0
end

