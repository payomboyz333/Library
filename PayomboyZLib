-- opts: {Name, Min, Max, Default, Increment, Suffix, Callback(value)}
function Section:AddSlider(opts)
	local win, T = self.Window, self.Theme
	opts = opts or {}
	local min, max = opts.Min or 0, opts.Max or 100
	local inc = opts.Increment or 1
	local value = math.clamp(opts.Default or min, min, max)

	local row = self:_row(58)
	text(T, {
		Parent = row,
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -110, 0, 22),
		Text = opts.Name or "Slider",
		TextSize = 14,
	})
	local valueLabel = text(T, {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 6),
		Size = UDim2.fromOffset(90, 22),
		TextSize = 12,
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local track = new("Frame", {
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = T.Stroke,
		BorderSizePixel = 0,
		Parent = row,
	}, { corner(3) })
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(3) })
	local hit = button(T, {
		Position = UDim2.fromOffset(12, 32),
		Size = UDim2.new(1, -24, 0, 22),
		BackgroundTransparency = 1,
		Parent = row,
	})

	local api = {}
	local function render()
		local a = (max - min) == 0 and 0 or (value - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		valueLabel.Text = tostring(value) .. (opts.Suffix or "")
	end
	function api.Get()
		return value
	end
	function api.Set(v, silent)
		v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
		v = tonumber(string.format("%.4f", v))
		if v == value then
			return
		end
		value = v
		render()
		if not silent and opts.Callback then
			task.spawn(opts.Callback, value)
		end
	end
	render()

	local dragging = false
	local function fromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		api.Set(min + (max - min) * a)
	end
	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	win:_connect(UserInputService.InputChanged, function(input)
		if
			dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
		then
			fromX(input.Position.X)
		end
	end)
	win:_connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	return api
end

