	}, { corner(8), list(0) })
	local head = new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundTransparency = 1,
		Parent = holder,
	})
	rowTitle(T, head, opts.Name or "Dropdown", nil, 180)
	local sel = button(T, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(150, 30),
		BackgroundColor3 = T.Background,
		Font = T.Font,
		TextSize = 12,
		Parent = head,
	}, { corner(6), stroke(T.Stroke, 1) })
	local items = new("Frame", {
		LayoutOrder = 2,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Visible = false,
		Parent = holder,
	}, { pad(8, 0, 8, 8), list(4) })

	local api = {}
	local options = opts.Options or {}
	local function paint()
		sel.Text = tostring(value or S.Select) .. "  " .. Library.Icons.Down
	end
	function api.Get()
		return value
	end
	function api.Set(v, silent)
		value = v
		paint()
		if not silent and opts.Callback then
			task.spawn(opts.Callback, value)
		end
	end
	local function build()
		for _, c in ipairs(items:GetChildren()) do
			if c:IsA("TextButton") then
				c:Destroy()
			end
		end
		for i, o in ipairs(options) do
			local ob = button(T, {
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, 28),
				BackgroundColor3 = T.Background,
				Font = T.Font,
				Text = tostring(o),
				TextSize = 12,
				Parent = items,
			}, { corner(6) })
			ob.MouseButton1Click:Connect(function()
				api.Set(o)
				items.Visible = false
			end)
		end
	end
	function api.SetOptions(list_)
		options = list_
		build()
	end
	sel.MouseButton1Click:Connect(function()
		items.Visible = not items.Visible
	end)
	build()
	paint()
	return api
end

