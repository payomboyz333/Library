function Window:Notify(opts)
	local T = self.Theme
	if type(opts) == "string" then
		opts = { Text = opts }
	end
	local colors = { Info = T.Info, Success = T.Success, Warning = T.Warning, Error = T.Danger }
	local color = colors[opts.Type or "Info"] or T.Info

	local toast = new("CanvasGroup", {
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Card,
		BorderSizePixel = 0,
		GroupTransparency = 1,
		Parent = self.NotifyHolder,
	}, { corner(10), stroke(T.StrokeAccent, 1), pad(12, 10, 12, 10), list(4) })

	local head = new("Frame", {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Parent = toast,
	})
	new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = head,
	}, { corner(4) })
	text(T, {
		Parent = head,
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(1, -16, 1, 0),
		Text = opts.Title or "",
		Font = T.FontBold,
		TextSize = 14,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if opts.Text then
		text(T, {
			LayoutOrder = 2,
			Parent = toast,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Text = tostring(opts.Text),
			TextSize = 12,
			TextColor3 = T.SubText,
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end

	tween(toast, { GroupTransparency = 0 }, 0.2)
	task.delay(opts.Duration or 4, function()
		if toast.Parent then
			local tw = tween(toast, { GroupTransparency = 1 }, 0.25)
			tw.Completed:Connect(function()
				toast:Destroy()
			end)
		end
	end)
	return toast
end

