local function merge(base, extra)
	if extra then
		for k, v in pairs(extra) do
			base[k] = v
		end
	end
	return base
end

local function new(className, props, children)
	local inst = Instance.new(className)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function pad(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l),
		PaddingTop = UDim.new(0, t or l),
		PaddingRight = UDim.new(0, r or l),
		PaddingBottom = UDim.new(0, b or t or l),
	})
end

local function list(padding, direction)
	return new("UIListLayout", {
		Padding = UDim.new(0, padding or 0),
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

local function tween(inst, props, t, style, dir)
	local tw = TweenService:Create(
		inst,
		TweenInfo.new(t or 0.15, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function hex(c)
	return string.format(
		"#%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

local function esc(s)
	s = tostring(s)
	s = string.gsub(s, "&", "&amp;")
	s = string.gsub(s, "<", "&lt;")
	s = string.gsub(s, ">", "&gt;")
	return s
end

local function toAsset(v)
	if type(v) == "number" then
		return "rbxassetid://" .. v
	end
	return v
end

local function isAsset(v)
	return type(v) == "string"
		and (string.sub(v, 1, 13) == "rbxassetid://" or string.sub(v, 1, 11) == "rbxasset://" or string.sub(v, 1, 4) == "http")
end

local function text(T, props)
	return new(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = T.Font,
			Text = "",
			TextColor3 = T.Text,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
		}, props)
	)
end

local function button(T, props, children)
	return new(
		"TextButton",
		merge({
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Font = T.FontBold,
			Text = "",
			TextColor3 = T.Text,
			TextSize = 13,
			BackgroundColor3 = T.Accent,
		}, props),
		children
	)
end

-- text glyph or image, depending on what `value` is
local function icon(T, value, size, color, extra)
	value = toAsset(value)
	if isAsset(value) then
		return new(
			"ImageLabel",
			merge({
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Image = value,
				ImageColor3 = color or Color3.new(1, 1, 1),
				Size = UDim2.fromOffset(size, size),
			}, extra)
		)
	end
	return new(
		"TextLabel",
		merge({
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Font = Enum.Font.GothamBold,
			Text = value or "",
			TextColor3 = color or T.Text,
			TextSize = size,
			Size = UDim2.fromOffset(size + 4, size + 4),
		}, extra)
	)
end

local function setIconColor(inst, color)
	if inst:IsA("ImageLabel") then
		inst.ImageColor3 = color
	else
		inst.TextColor3 = color
	end
end

local function firstChar(s)
	local nxt = utf8.offset(s, 2)
	if nxt then
		return string.sub(s, 1, nxt - 1)
	end
	return s
end

-- on/off switch used by Toggle and the sidebar mode toggle
local function buildSwitch(T, parent, default, onChange, extra)
	local state = default == true
	local track = button(
		T,
		merge({
			Size = UDim2.fromOffset(40, 22),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			BackgroundColor3 = state and T.Accent or T.Stroke,
			Parent = parent,
		}, extra),
		{ corner(11) }
	)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, state and 21 or 3, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = track,
	}, { corner(8) })

	local api = {}
	function api.Get()
		return state
	end
	function api.Set(v, silent)
		v = v == true
		if v == state then
			return
		end
		state = v
		tween(track, { BackgroundColor3 = state and T.Accent or T.Stroke }, 0.15)
		tween(knob, { Position = UDim2.new(0, state and 21 or 3, 0.5, 0) }, 0.15)
		if not silent and onChange then
			onChange(state)
		end
	end
	track.MouseButton1Click:Connect(function()
		api.Set(not state)
	end)
	api.Track = track
	return api
end

local function makeDraggable(win, handle, target)
	local dragging, startMouse, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startMouse = input.Position
			startPos = target.Position
		end
	end)
	win:_connect(UserInputService.InputChanged, function(input)
		if
			dragging
			and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch)
		then
			local d = input.Position - startMouse
			target.Position =
				UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	win:_connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

