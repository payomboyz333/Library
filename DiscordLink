-- ======================================================================================
-- 🛠️ ASSET LOADER (AUTO-CACHE TO DISK & GETCUSTOMASSET)
-- ======================================================================================
local function GetLogoAsset()
    local customAssetFn = getcustomasset or getsynasset
    local requestFn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    
    if customAssetFn and writefile and readfile and isfile and requestFn then
        local success, assetUri = pcall(function()
            if not isfile(LOGO_CACHE_NAME) then
                local res = requestFn({
                    Url = LOGO_URL,
                    Method = "GET"
                })
                if res and res.Body and #res.Body > 100 then
                    writefile(LOGO_CACHE_NAME, res.Body)
                end
            end
            if isfile(LOGO_CACHE_NAME) then
                return customAssetFn(LOGO_CACHE_NAME)
            end
        end)
        if success and assetUri then
            return assetUri
        end
    end
    return LOGO_FALLBACK
end

-- ======================================================================================
-- 🔗 CLIPBOARD & DISCORD RPC AUTO-JOIN ENGINE
-- ======================================================================================
local function CopyToClipboard(text)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard) or (Clipboard and Clipboard.set)
    if fn then
        pcall(fn, text)
        return true
    end
    return false
end

local function JoinDiscordRPC()
    local requestFn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)
    
    -- Always copy link first to ensure user has it
    CopyToClipboard(DISCORD_INVITE_URL)
    
    -- Attempt Local RPC to prompt Discord Desktop Client
    if requestFn then
        task.spawn(function()
            for port = 6463, 6465 do
                pcall(function()
                    requestFn({
                        Url = string.format("http://127.0.0.1:%d/rpc?v=1", port),
                        Method = "POST",
                        Headers = {
                            ["Content-Type"] = "application/json",
                            ["Origin"] = "https://discord.com"
                        },
                        Body = HttpService:JSONEncode({
                            cmd = "INVITE_BROWSER",
                            args = { code = DISCORD_INVITE_CODE },
                            nonce = HttpService:GenerateGUID(false)
                        })
                    })
                end)
            end
        end)
    end
end

